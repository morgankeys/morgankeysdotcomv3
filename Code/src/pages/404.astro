---
/**
 * Not-found page: sends any unknown route to the home page.
 *
 * The site is static, so there is no server to issue a redirect. Vercel (and
 * `astro dev`) serve this page for any path with no matching file, still with
 * a 404 status, so search engines drop dead URLs rather than indexing them as
 * copies of the home page. The page then hands the visitor to `/` straight
 * away. That covers unknown case-study ids under /work/ too.
 */
import { SITE_TITLE } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{SITE_TITLE}</title>
    {/* Replaces the dead URL in history, so Back skips it. */}
    <script is:inline>
      location.replace("/");
    </script>
    {/* Fallback for visitors without JavaScript. */}
    <meta http-equiv="refresh" content="0; url=/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <p>This page doesn’t exist. <a href="/">Go to the home page</a>.</p>
  </body>
</html>
