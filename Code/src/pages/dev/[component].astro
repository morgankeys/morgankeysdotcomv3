---
/**
 * Component specimen pages. Built on the dev server and on feature-branch
 * previews only (showDraftContent); never on staging or production.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.vue";
import IconButton from "../../components/IconButton.vue";
import SegmentedButton from "../../components/SegmentedButton.vue";
import Fab from "../../components/Fab.vue";
import FabMenu from "../../components/FabMenu.vue";
import TextField from "../../components/TextField.vue";
import Chip from "../../components/Chip.vue";
import Divider from "../../components/Divider.astro";
import Tooltip from "../../components/Tooltip.vue";
import ArticleHeader from "../../components/ArticleHeader.astro";
import PullQuote from "../../components/PullQuote.astro";
import Callout from "../../components/Callout.astro";
import Prose from "../../components/Prose.astro";
import { showDraftContent } from "../../lib/env";

export function getStaticPaths() {
  if (!showDraftContent) {
    return [];
  }

  return [
    { params: { component: "icon-button" } },
    { params: { component: "button" } },
    { params: { component: "segmented-button" } },
    { params: { component: "fab" } },
    { params: { component: "fab-menu" } },
    { params: { component: "text-field" } },
    { params: { component: "chip" } },
    { params: { component: "divider" } },
    { params: { component: "tooltip" } },
    { params: { component: "editorial" } },
  ];
}

const { component } = Astro.params;

const iconButtonVariants = ["filled", "tonal", "outlined", "standard"] as const;
const buttonVariants = [
  "filled",
  "tonal",
  "outlined",
  "elevated",
  "text",
] as const;
const sizes = ["xs", "sm", "md", "lg", "xl"] as const;
const shapes = ["round", "square"] as const;
const widths = ["narrow", "default", "wide"] as const;

const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>`;
const starOutlineSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
const segmentOptions = [
  { value: "day", label: "Day" },
  { value: "week", label: "Week" },
  { value: "month", label: "Month" },
];
const fabColors = [
  "primary-container",
  "secondary-container",
  "tertiary-container",
  "primary",
  "secondary",
  "tertiary",
] as const;
const fabSizes = ["sm", "md", "lg"] as const;
const fabMenuColors = ["primary", "secondary", "tertiary"] as const;
const fabMenuItems = [
  { label: "Message", value: "message" },
  { label: "Résumé", value: "resume" },
  { label: "LinkedIn", href: "#" },
];
const buttonIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
---

{
  component === "icon-button" && (
    <BaseLayout title="IconButton specimen">
      <main class="specimen">
        <h1 class="specimen__title">IconButton</h1>

        {iconButtonVariants.map((variant) => (
          <section class="specimen__section">
            <h2 class="specimen__heading">{variant}</h2>

            {shapes.map((shape) => (
              <div class="specimen__group">
                <h3 class="specimen__subheading">{shape}</h3>

                {sizes.map((size) => (
                  <div class="specimen__row">
                    <span class="specimen__label">{size}</span>
                    <div class="specimen__grid">
                      {widths.map((width) => (
                        <IconButton
                          label={`${variant} ${size} ${shape} ${width}`}
                          {variant}
                          {size}
                          {shape}
                          {width}
                        >
                          <Fragment set:html={iconSvg} />
                        </IconButton>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </section>
        ))}

        <section class="specimen__section">
          <h2 class="specimen__heading">toggle</h2>

          {iconButtonVariants.map((variant) => (
            <div class="specimen__row">
              <span class="specimen__label">{variant}</span>
              <div class="specimen__grid">
                {shapes.map((shape) =>
                  [false, true].map((selected) => (
                    <IconButton
                      label={`${variant} ${shape} toggle, ${selected ? "selected" : "unselected"}`}
                      {variant}
                      {shape}
                      size="md"
                      toggle
                      {selected}
                    >
                      <Fragment set:html={starOutlineSvg} />
                      <Fragment slot="selected" set:html={buttonIconSvg} />
                    </IconButton>
                  )),
                )}
              </div>
            </div>
          ))}
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">disabled</h2>
          <div class="specimen__grid">
            {iconButtonVariants.map((variant) => (
              <IconButton
                label={`${variant} disabled`}
                {variant}
                size="sm"
                disabled
              >
                <Fragment set:html={iconSvg} />
              </IconButton>
            ))}
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "button" && (
    <BaseLayout title="Button specimen">
      <main class="specimen">
        <h1 class="specimen__title">Button</h1>

        {buttonVariants.map((variant) => (
          <section class="specimen__section">
            <h2 class="specimen__heading">{variant}</h2>

            {shapes.map((shape) => (
              <div class="specimen__group">
                <h3 class="specimen__subheading">{shape}</h3>

                {sizes.map((size) => (
                  <div class="specimen__row">
                    <span class="specimen__label">{size}</span>
                    <div class="specimen__grid">
                      <Button {variant} {size} {shape}>
                        <Fragment slot="icon" set:html={buttonIconSvg} />
                        Label
                      </Button>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </section>
        ))}

        <section class="specimen__section">
          <h2 class="specimen__heading">label only</h2>
          <div class="specimen__grid">
            {buttonVariants.map((variant) => (
              <Button {variant} size="sm">
                Label
              </Button>
            ))}
          </div>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">disabled</h2>
          <div class="specimen__grid">
            {buttonVariants.map((variant) => (
              <Button {variant} size="sm" disabled>
                <Fragment slot="icon" set:html={buttonIconSvg} />
                Label
              </Button>
            ))}
          </div>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">link</h2>
          <Button variant="filled" size="sm" as="a" href="#">
            <Fragment slot="icon" set:html={buttonIconSvg} />
            Link
          </Button>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "segmented-button" && (
    <BaseLayout title="SegmentedButton specimen">
      <main class="specimen">
        <h1 class="specimen__title">SegmentedButton</h1>

        <section class="specimen__section">
          <h2 class="specimen__heading">label</h2>
          <div class="specimen__grid">
            <SegmentedButton
              label="Range"
              options={segmentOptions}
              modelValue="week"
            />
          </div>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">icon only</h2>
          <div class="specimen__grid">
            <SegmentedButton
              label="Rating"
              options={segmentOptions}
              modelValue="day"
              iconOnly
            >
              <Fragment slot="icon" set:html={buttonIconSvg} />
            </SegmentedButton>
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "fab" && (
    <BaseLayout title="Fab specimen">
      <main class="specimen">
        <h1 class="specimen__title">Fab</h1>

        {fabSizes.map((size) => (
          <section class="specimen__section">
            <h2 class="specimen__heading">{size}</h2>
            <div class="specimen__grid">
              {fabColors.map((color) => (
                <Fab label={`${color} ${size}`} {color} {size}>
                  <Fragment set:html={buttonIconSvg} />
                </Fab>
              ))}
            </div>
            <div class="specimen__grid specimen__grid--spaced">
              {fabColors.map((color) => (
                <Fab label="Label" {color} {size} extended>
                  <Fragment set:html={buttonIconSvg} />
                </Fab>
              ))}
            </div>
          </section>
        ))}
      </main>
    </BaseLayout>
  )
}

{
  component === "fab-menu" && (
    <BaseLayout title="FabMenu specimen">
      <main class="specimen">
        <h1 class="specimen__title">FabMenu</h1>

        <section class="specimen__section">
          <h2 class="specimen__heading">colors</h2>
          <div class="specimen__grid specimen__grid--menus">
            {fabMenuColors.map((color) => (
              <FabMenu
                label={`Open ${color} menu`}
                {color}
                items={fabMenuItems}
                client:load
              >
                <Fragment set:html={iconSvg} />
                <Fragment slot="icon" set:html={buttonIconSvg} />
              </FabMenu>
            ))}
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "text-field" && (
    <BaseLayout title="TextField specimen">
      <main class="specimen">
        <h1 class="specimen__title">TextField</h1>

        {(["outlined", "filled"] as const).map((variant) => (
          <section class="specimen__section">
            <h2 class="specimen__heading">{variant}</h2>
            <div class="specimen__fields">
              <TextField id={`${variant}-empty`} label="Empty" {variant} />
              <TextField
                id={`${variant}-filled`}
                label="Populated"
                modelValue="Morgan"
                supportingText="Supporting text"
                {variant}
              />
              <TextField
                id={`${variant}-error`}
                label="Email"
                modelValue="morgan@"
                errorText="Please enter a valid email"
                {variant}
              />
              <TextField
                id={`${variant}-disabled`}
                label="Disabled"
                modelValue="Can't edit"
                disabled
                {variant}
              />
              <TextField
                id={`${variant}-live`}
                label="Type here"
                supportingText="Hydrated, so the label floats as you type"
                {variant}
                client:load
              />
              <TextField
                id={`${variant}-multiline`}
                label="Message"
                multiline
                rows={3}
                {variant}
                client:load
              />
            </div>
          </section>
        ))}
      </main>
    </BaseLayout>
  )
}

{
  component === "chip" && (
    <BaseLayout title="Chip specimen">
      <main class="specimen">
        <h1 class="specimen__title">Chip</h1>

        <section class="specimen__section">
          <h2 class="specimen__heading">static</h2>
          <div class="specimen__grid">
            <Chip>Design systems</Chip>
            <Chip elevated>Prototyping</Chip>
            <Chip>
              <Fragment slot="icon" set:html={buttonIconSvg} />
              With icon
            </Chip>
          </div>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">assist</h2>
          <div class="specimen__grid">
            <Chip as="button">Outlined</Chip>
            <Chip as="button" elevated>
              Elevated
            </Chip>
            <Chip as="a" href="#">
              <Fragment slot="icon" set:html={buttonIconSvg} />
              Link
            </Chip>
            <Chip as="button" disabled>
              Disabled
            </Chip>
          </div>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">filter</h2>
          <div class="specimen__grid">
            <Chip as="button" variant="filter">
              Unselected
            </Chip>
            <Chip as="button" variant="filter" selected>
              Selected
            </Chip>
            <Chip as="button" variant="filter" elevated>
              Elevated
            </Chip>
            <Chip as="button" variant="filter" selected disabled>
              Disabled
            </Chip>
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "divider" && (
    <BaseLayout title="Divider specimen">
      <main class="specimen">
        <h1 class="specimen__title">Divider</h1>

        {(["none", "start", "middle"] as const).map((inset) => (
          <section class="specimen__section">
            <h2 class="specimen__heading">{`inset: ${inset}`}</h2>
            <div class="specimen__surface">
              <p class="specimen__line">Above</p>
              <Divider {inset} />
              <p class="specimen__line">Below</p>
            </div>
          </section>
        ))}

        <section class="specimen__section">
          <h2 class="specimen__heading">vertical</h2>
          <div class="specimen__surface specimen__surface--row">
            <p class="specimen__line">Left</p>
            <Divider vertical />
            <p class="specimen__line">Middle</p>
            <Divider vertical inset="middle" />
            <p class="specimen__line">Right</p>
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "tooltip" && (
    <BaseLayout title="Tooltip specimen">
      <main class="specimen">
        <h1 class="specimen__title">Tooltip</h1>

        <section class="specimen__section">
          <h2 class="specimen__heading">plain</h2>
          <div class="specimen__grid specimen__grid--tooltips">
            {(["start", "center", "end"] as const).map((align) => (
              <Tooltip text={`Aligned ${align}`} {align} client:load>
                <IconButton label={`Tooltip aligned ${align}`} variant="tonal">
                  <Fragment set:html={iconSvg} />
                </IconButton>
              </Tooltip>
            ))}
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  component === "editorial" && (
    <BaseLayout title="Editorial specimen">
      <main class="specimen specimen--column">
        <h1 class="specimen__title">Editorial</h1>

        <section class="specimen__section">
          <h2 class="specimen__heading">article header</h2>
          <ArticleHeader
            level={2}
            eyebrow="Case study · 2024"
            title="Rebuilding the transit app"
            standfirst="Nine months spent removing features, and what the riders kept asking for."
            byline={["Product design", "14 min read", "Case study"]}
          />
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">pull quote</h2>
          <PullQuote attribution="Field note, week three">
            If someone has to read the manual, the screen has already failed.
          </PullQuote>
          <PullQuote variant="centered" attribution="Field note, week three">
            If someone has to read the manual, the screen has already failed.
          </PullQuote>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">prose blockquote</h2>
          <Prose>
            <p>Copy before the quote sets it up.</p>
            <blockquote>
              A bare blockquote in Prose matches the rule variant.
            </blockquote>
            <p>Copy after the quote picks the thread back up.</p>
          </Prose>
        </section>

        <section class="specimen__section">
          <h2 class="specimen__heading">callout</h2>
          <Callout heading="A constraint worth stating">
            <p>
              For asides and constraints, not for warnings. The heading is
              optional.
            </p>
          </Callout>
        </section>
      </main>
    </BaseLayout>
  )
}

<style>
  .specimen {
    padding: var(--dune-sys-spacing-ui-3xl) var(--dune-sys-spacing-ui-xl);
    color: var(--dune-sys-color-on-surface);
    background-color: var(--dune-sys-color-surface);
  }

  .specimen__title {
    margin: 0 0 var(--dune-sys-spacing-ui-2xl);
    font-family: var(--dune-sys-typescale-headline-large-font);
    font-size: var(--dune-sys-typescale-headline-large-size);
    font-weight: var(--dune-sys-typescale-headline-large-weight);
    line-height: var(--dune-sys-typescale-headline-large-line-height);
  }

  .specimen__section {
    margin-bottom: var(--dune-sys-spacing-ui-3xl);
  }

  .specimen__heading {
    margin: 0 0 var(--dune-sys-spacing-ui-lg);
    font-family: var(--dune-sys-typescale-title-large-font);
    font-size: var(--dune-sys-typescale-title-large-size);
    font-weight: var(--dune-sys-typescale-title-large-weight);
    text-transform: capitalize;
  }

  .specimen__subheading {
    margin: var(--dune-sys-spacing-ui-xl) 0 var(--dune-sys-spacing-ui-md);
    font-family: var(--dune-sys-typescale-title-medium-font);
    font-size: var(--dune-sys-typescale-title-medium-size);
    font-weight: var(--dune-sys-typescale-title-medium-weight);
    text-transform: capitalize;
  }

  .specimen__group {
    margin-bottom: var(--dune-sys-spacing-ui-xl);
  }

  .specimen__row {
    display: flex;
    align-items: center;
    gap: var(--dune-sys-spacing-ui-lg);
    margin-bottom: var(--dune-sys-spacing-ui-md);
  }

  .specimen__label {
    flex: 0 0 2rem;
    font-family: var(--dune-sys-typescale-label-medium-font);
    font-size: var(--dune-sys-typescale-label-medium-size);
    color: var(--dune-sys-color-on-surface-variant);
  }

  .specimen__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--dune-sys-spacing-ui-md);
  }

  .specimen__fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--dune-sys-spacing-ui-xl);
    max-width: var(--dune-sys-spacing-breakpoints-lg);
  }

  .specimen__grid--tooltips {
    gap: var(--dune-sys-spacing-ui-4xl);
    padding-bottom: var(--dune-sys-spacing-ui-3xl);
  }

  .specimen__surface {
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-ui-md);
    max-width: 480px;
    padding-block: var(--dune-sys-spacing-ui-md);
    border-radius: var(--dune-sys-shape-corner-medium);
    background-color: var(--dune-sys-color-surface-container-low);
  }

  .specimen__surface--row {
    flex-direction: row;
    align-items: stretch;
    height: 120px;
    padding-inline: var(--dune-sys-spacing-ui-md);
  }

  .specimen__line {
    margin: 0;
    padding-inline: var(--dune-sys-spacing-ui-lg);
  }

  /* Editorial components read at a column width, as in a case study. */
  .specimen--column > :global(*) {
    max-width: 680px;
  }

  .specimen__grid--spaced {
    margin-top: var(--dune-sys-spacing-ui-xl);
  }

  /* Menus open upward, so leave room above their toggles. */
  .specimen__grid--menus {
    align-items: flex-end;
    gap: var(--dune-sys-spacing-ui-5xl);
    min-height: 320px;
  }
</style>
