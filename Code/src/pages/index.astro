---
/**
 * Home page.
 *
 * Layout mirrors the Figma "Home" frame (desktop node 339:1673, mobile 353:2308):
 *  - full-width case-study carousel
 *  - two-column body: profile sidebar + main content column
 *    (stacks to a single column on narrow viewports)
 *  - main column sections: case-study decks, interactive demos, CV,
 *    older projects, and a contact block
 *
 * Case-study cards and the overlays they open both read from the registry in
 * src/lib/case-studies/, so this page only declares the intro card.
 *
 * NOTE: the resume link is a placeholder — replace with real content.
 */
import type { ImageMetadata } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.vue";
import Carousel from "../components/Carousel.vue";
import ContactForm from "../components/ContactForm.vue";
import IntroCard from "../components/IntroCard.astro";
import IntroOverlay from "../components/IntroOverlay.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import BusinessHomeOverlay from "../components/case-studies/business-home.astro";
import AiPrototypingKitOverlay from "../components/case-studies/ai-prototyping-kit.astro";
import PublicEdSitesOverlay from "../components/case-studies/public-ed-sites.astro";
import CiscoCybersecurityOverlay from "../components/case-studies/cisco-cybersecurity.astro";
import AutodeskSsoOverlay from "../components/case-studies/autodesk-sso.astro";
import ChartOfAccountsOverlay from "../components/case-studies/chart-of-accounts.astro";
import { caseStudies, toCarouselCard } from "../lib/case-studies";
import HorizontalCard from "../components/HorizontalCard.astro";
import StackedCard from "../components/StackedCard.astro";
import ProjectRow from "../components/ProjectRow.astro";
import FactsList from "../components/FactsList.astro";
import Button from "../components/Button.astro";
import Logo from "../components/Logo.astro";
import type { LogoName } from "../components/Logo.astro";
import type { AssetGridLayout, AssetItem } from "../components/AssetGrid.astro";

// Carousel imagery. Case-study cards get theirs from the registry; only the
// intro card, which is not a case study, is sourced here.
import portrait from "../assets/home/carousel/morgan-portrait.png";
import introHero from "../assets/home/intro/hero.png";
import publicEdSites from "../assets/home/carousel/public-ed-sites.png";
import ciscoCybersecurity from "../assets/home/carousel/cisco-cybersecurity.png";

// Decks + demos
import deckAutodesk from "../assets/home/decks/autodesk-sso.png";
import demoCoa from "../assets/home/demos/opengov-coa-manager.png";
import demoNetwork from "../assets/home/demos/opengov-network.png";

// Company marks
import boardableMark from "../assets/logos/company/boardable.svg";
import buildingConnectedMark from "../assets/logos/company/buildingconnected.png";
import opengovMark from "../assets/logos/company/opengov.png";
import hightailMark from "../assets/logos/company/hightail.png";

// Older-project media
import surveys from "../assets/work/boardable-surveys/surveys.png";
import surveysFeedback from "../assets/work/boardable-surveys/feedback.png";
import aiMinutesPrimary from "../assets/work/ai-minutes/primary.png";
import aiMinutesSecondary from "../assets/work/ai-minutes/secondary.png";
import dsMain from "../assets/work/design-systems/main.png";
import dsSquare1 from "../assets/work/design-systems/square-1.png";
import dsSquare2 from "../assets/work/design-systems/square-2.png";
import ogNetwork from "../assets/work/opengov-network/network.png";
import hightailReport from "../assets/work/hightail-enterprise/report.png";
import uplink from "../assets/work/hightail-uplink/uplink.png";

/** Dialog id, card `data-overlay-target`, and URL fragment for the intro overlay. */
const INTRO_OVERLAY_ID = "intro";

// The intro card is not a case study, so it is declared here; the rest come
// from the registry, which the overlays they open read from too.
const introCard = {
  title: "Hi, I'm Morgan",
  subtitle: "Product Designer, AI-Builder",
  body: "I help product teams solve their hardest use-cases. Through a focus on curiosity, constant improvement, and craft, I turn messy problems spaces into clarity and real products. I believe that AI can help design reach it’s full potential of creating intuitive and valuable experiences at scale. Let’s talk about product, design, artificial intelligence—and about what change means in the real world.",
  href: `#${INTRO_OVERLAY_ID}`,
  overlayId: INTRO_OVERLAY_ID,
  image: portrait,
  imageAlt: "Portrait of Morgan Keys",
};

const decks = [
  {
    title: "Public Ed Sites",
    subtitle: "Boardable, 2025",
    href: "https://www.figma.com/deck/NNb1ZY5DqjMoAIKcsoWCuq/-case-study--Boardable-Public-Ed-Pages?node-id=0-1&t=FUXIgWlQA7ZlKM89-1",
    image: publicEdSites,
    imageAlt: "Public education sites",
  },
  {
    title: "Cisco Cybersecurity",
    subtitle: "DesignMap, 2023",
    href: "https://www.figma.com/deck/SIH4JZ1mk69GyhuungiqNT/-case-study--Cisco-XDR--2022-?node-id=0-1&t=p5f658bMHtKmeqv0-1",
    image: ciscoCybersecurity,
    imageAlt: "Cisco cybersecurity",
  },
  {
    title: "Autodesk SSO",
    subtitle: "Autodesk, 2020",
    href: "https://www.figma.com/deck/pNOmkOSvKYFaItMa8HDUWm/-case-study--Autodesk-ID?node-id=0-1&t=DjttmneWz6wHGAKZ-1",
    image: deckAutodesk,
    imageAlt: "Autodesk single sign-on",
  },
];

const demos = [
  {
    title: "OpenGov CoA Manager",
    subtitle: "Figma Make",
    body: "Simplified for general audiences. Explore the unique interaction paradigm that earned OpenGov a patent.",
    image: demoCoa,
    imageAlt: "OpenGov chart-of-accounts manager prototype",
    href: "https://www.figma.com/make/lDDxq1qeemMarlP2d465vp/-Prototype--COA-Manager-Rebuild?t=H5k7V31xVvAVXiV5-20&fullscreen=1",
  },
  {
    title: "OpenGov Network",
    subtitle: "Figma Make",
    body: "A recreation of the MVP I designed at OpenGov — a way to explore the OpenGov Network and browse municipal metrics.",
    image: demoNetwork,
    imageAlt: "OpenGov Network prototype",
    href: "https://www.figma.com/make/evDtT9BmTbDdS1b81aSxPy/-Prototype--OpenGov-Network?t=RgTGkbPGihkV7vZt-20&fullscreen=1",
  },
];

const careerPath = [
  "3 scaling-stage startups, multiple exits",
  "Large teams: Autodesk and Google",
  "Strategic work at DesignMap",
  "Long track record of building tools and design systems",
];

const academics = [
  "Dual Bachelor's degrees in Math & Creative writing",
  "Masters from University of Michigan's School of Information (Human-Computer Interaction)",
  "Masters specialization in decision science",
  "Interests in statistics and agent-based modeling",
];

const quickFacts = [
  "Senior/Staff Product Designer with strong technical execution",
  "AI-enabled builder of rich prototypes, experience shipping to production.",
  "End-to-end skills: contextual inquiry to strategy to shipping code.",
  "Strategic product sense honed by deep experience with scaling start-ups.",
  "Long track record of building collaborative tools for B2B and SaaS, highly regulated environments.",
  "Co-inventor on patented design.",
];

interface Project {
  title: string;
  company: string;
  companyLogo?: ImageMetadata;
  layout: AssetGridLayout;
  assets: AssetItem[];
  paragraphs: string[];
  link?: { prefix: string; href: string; label: string; suffix: string };
}

const projects: Project[] = [
  {
    title: "Boardable Surveys",
    company: "Boardable, 2025",
    companyLogo: boardableMark,
    layout: "duo",
    assets: [
      { image: surveys, alt: "Boardable Surveys interface" },
      { image: surveysFeedback, alt: "Boardable Surveys feedback dashboard" },
    ],
    paragraphs: [
      "Created an experience for generating and confirming/editing AI-generated meeting minutes.",
      "Opened a new line of business and expanded Boardable from a catch-all app to a platform.",
    ],
  },
  {
    title: "AI Minutes / AI Meeting Assistant",
    company: "Boardable, 2025",
    companyLogo: boardableMark,
    layout: "duo",
    assets: [
      { image: aiMinutesPrimary, alt: "AI meeting assistant primary view" },
      { image: aiMinutesSecondary, alt: "AI meeting assistant detail" },
    ],
    paragraphs: [
      "Created an experience for generating and confirming/editing AI-generated meeting minutes.",
      "Also, designed an in-meeting AI assistant experience.",
    ],
  },
  {
    title: "Design Systems",
    company: "BuildingConnected, 2018",
    companyLogo: buildingConnectedMark,
    layout: "primary-pair",
    assets: [
      { image: dsMain, alt: "Design system overview" },
      { image: dsSquare1, alt: "Design system Sketch library" },
      { image: dsSquare2, alt: "Design system Styleguidist" },
    ],
    paragraphs: [
      "Evolved a Sketch library into an integrated design system.",
      "Worked closely with the front-end engineering team to develop a standardized style guide and component library. Evangelized design systems to designers and engineers.",
    ],
  },
  {
    title: "OpenGov Network",
    company: "OpenGov, 2015",
    companyLogo: opengovMark,
    layout: "solo",
    assets: [
      { image: ogNetwork, alt: "OpenGov Network" },
    ],
    paragraphs: [
      "Designed an experience for users to search for other governments on the OpenGov network.",
      "Delivered a new app for the OpenGov platform that strategically leveraged and promoted platform capabilities.",
    ],
    link: {
      prefix: "View a ",
      href: "#demos",
      label: "recreation of it here",
      suffix: ".",
    },
  },
  {
    title: "Hightail Enterprise",
    company: "Hightail (formerly YouSendIt), 2014",
    companyLogo: hightailMark,
    layout: "solo",
    assets: [
      { image: hightailReport, alt: "Hightail Enterprise reporting" },
    ],
    paragraphs: [
      "Created an administrative feature for enterprise accounts to meet e-discovery requirements, giving admins a simple yet powerful interface to monitor activity.",
      "Enabled the Hightail Enterprise offering, a new strategic line of business.",
    ],
  },
  {
    title: "Hightail Uplink",
    company: "Hightail (formerly YouSendIt), 2013",
    companyLogo: hightailMark,
    layout: "solo",
    assets: [
      { image: uplink, alt: "Hightail Uplink" },
    ],
    paragraphs: [
      "Advocated for redesigning and reviving a popular legacy feature. Created key onboarding and engagement experiences that produced significant upticks in adoption and engagement (+8k users and +45k file-sends in the first 3 months).",
    ],
  },
];

const headerSocials: { name: LogoName; href: string; label: string }[] = [
  { name: "github", href: "https://github.com/morgankeys", label: "GitHub" },
  { name: "linkedin", href: "https://www.linkedin.com/in/morgankeys/", label: "LinkedIn" },
  { name: "threads", href: "https://www.threads.com/@morgankeys", label: "Threads" },
  { name: "substack", href: "https://substack.com/@morgankeys", label: "Substack" },
  { name: "x", href: "https://x.com/morgankeys", label: "X" },
];

const contactSocials: { name: LogoName; href: string; label: string }[] = [
  { name: "github", href: "https://github.com/morgankeys", label: "GitHub" },
  { name: "linkedin", href: "https://www.linkedin.com/in/morgankeys/", label: "LinkedIn" },
  { name: "x", href: "https://x.com/morgankeys", label: "X" },
  { name: "threads", href: "https://www.threads.com/@morgankeys", label: "Threads" },
];
---

<BaseLayout title="Portfolio">
  <div class="theme-toggle">
    <ThemeToggle client:load />
  </div>

  <main class="home">
    <section class="carousel-section" aria-label="Featured case studies">
      <Carousel client:visible>
        <IntroCard {...introCard} />
        {
          caseStudies.map((study) => (
            <CaseStudyCard {...toCarouselCard(study)} />
          ))
        }
      </Carousel>
    </section>

    <IntroOverlay
      id={INTRO_OVERLAY_ID}
      title={introCard.title}
      subtitle={introCard.subtitle}
      body={introCard.body}
      image={introHero}
      imageAlt={introCard.imageAlt}
    />
    <BusinessHomeOverlay />
    <AiPrototypingKitOverlay />
    <PublicEdSitesOverlay />
    <CiscoCybersecurityOverlay />
    <AutodeskSsoOverlay />
    <ChartOfAccountsOverlay />

    <div class="page">
      <div class="body">
      <aside class="profile">
        <header class="intro">
          <div class="intro-identity">
            <div class="intro-title">
              <h1 class="name">Morgan Keys</h1>
              <p class="role">Product Designer, AI-Builder</p>
            </div>
            <nav class="socials" aria-label="Social links">
              {
                headerSocials.map((s) => (
                  <a class="social" href={s.href} aria-label={s.label}>
                    <Logo name={s.name} />
                  </a>
                ))
              }
            </nav>
          </div>
          <div class="actions">
            <Button variant="filled" as="a" href="/resume.pdf">
              <svg slot="icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  d="M10 13.33 5.83 9.17 7 7.96l2.17 2.16V3.33h1.66v6.79L13 7.96l1.17 1.21L10 13.33ZM5 16.67c-.46 0-.85-.16-1.18-.49-.33-.33-.49-.72-.49-1.18V12.5H5V15h10v-2.5h1.67V15c0 .46-.16.85-.49 1.18-.33.33-.72.49-1.18.49H5Z"
                ></path>
              </svg>
              Resume
            </Button>
            <Button variant="filled" as="a" href="#contact">
              <svg slot="icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  d="M3.33 16.67c-.46 0-.85-.16-1.18-.49-.33-.33-.49-.72-.49-1.18V5c0-.46.16-.85.49-1.18.33-.33.72-.49 1.18-.49h13.34c.46 0 .85.16 1.18.49.33.33.49.72.49 1.18v10c0 .46-.16.85-.49 1.18-.33.33-.72.49-1.18.49H3.33ZM10 10.83 3.33 6.67V15h13.34V6.67L10 10.83Zm0-1.66L16.67 5H3.33L10 9.17Z"
                ></path>
              </svg>
              Message
            </Button>
          </div>
        </header>

        <FactsList heading="Quick facts :" items={quickFacts} variant="compact" />
      </aside>

      <div class="main-column">
        <section class="section">
          <h2 class="section-title">Case study decks</h2>
          <div class="deck-grid">
            {
              decks.map((d) => (
                <HorizontalCard
                  title={d.title}
                  subtitle={d.subtitle}
                  href={d.href}
                  image={d.image}
                  imageAlt={d.imageAlt}
                />
              ))
            }
          </div>
        </section>

        <section class="section" id="demos">
          <h2 class="section-title">Interactive demos</h2>
          <div class="demo-grid">
            {
              demos.map((d) => (
                <StackedCard
                  title={d.title}
                  subtitle={d.subtitle}
                  body={d.body}
                  image={d.image}
                  imageAlt={d.imageAlt}
                  href={d.href}
                />
              ))
            }
          </div>
        </section>

        <section class="section">
          <h2 class="section-title">Curriculum vitae</h2>
          <div class="cv-grid">
            <div class="cv-card">
              <FactsList heading="Career path" items={careerPath} variant="card" />
            </div>
            <div class="cv-card">
              <FactsList heading="Academic background" items={academics} variant="card" />
            </div>
          </div>
        </section>

        <section class="section">
          <h2 class="section-title">Older projects</h2>
          <div class="project-list">
            {
              projects.map((p) => (
                <ProjectRow
                  title={p.title}
                  company={p.company}
                  companyLogo={p.companyLogo}
                  layout={p.layout}
                  assets={p.assets}
                >
                  {p.paragraphs.map((text) => (
                    <p>{text}</p>
                  ))}
                  {p.link && (
                    <p>
                      {p.link.prefix}
                      <a href={p.link.href}>{p.link.label}</a>
                      {p.link.suffix}
                    </p>
                  )}
                </ProjectRow>
              ))
            }
          </div>
        </section>

        <section class="section contact" id="contact">
          <h2 class="contact-title">Ready to chat?</h2>
          <div class="contact-inner">
            <div class="contact-block">
              <p class="contact-label center">Find me on the socials:</p>
              <nav class="socials center" aria-label="Social links">
                {
                  contactSocials.map((s) => (
                    <a class="social" href={s.href} aria-label={s.label}>
                      <Logo name={s.name} />
                    </a>
                  ))
                }
              </nav>
            </div>
            <div class="contact-block">
              <p class="contact-label">Or shoot me a message:</p>
              <ContactForm client:visible />
            </div>
          </div>
        </section>
      </div>
    </div>
    </div>
  </main>
</BaseLayout>

<style>
  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-section);
    padding-block: var(--md-sys-spacing-body-to-subsection);
  }

  /*
   * Full-bleed carousel: the track spans the viewport so cards scroll off
   * screen, but its inline padding aligns the first/last slide with the
   * max-width page content beside it.
   */
  .carousel-section :global(.track) {
    padding-inline: max(
      var(--md-sys-spacing-body-to-subsection),
      calc((100vw - 1200px) / 2 + var(--md-sys-spacing-body-to-subsection))
    );
    scroll-padding-inline: max(
      var(--md-sys-spacing-body-to-subsection),
      calc((100vw - 1200px) / 2 + var(--md-sys-spacing-body-to-subsection))
    );
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--md-sys-spacing-body-to-subsection);
    width: 100%;
  }

  .body {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--md-sys-spacing-ui-3xl);
    align-items: start;
  }

  .profile {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-subsection);
    position: sticky;
    top: 1.5rem;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-md);
  }

  .intro-identity {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-lg);
    width: 100%;
  }

  .intro-title {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .name {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-display-small-font);
    font-size: var(--md-sys-typescale-display-small-size);
    font-weight: var(--md-sys-typescale-display-small-weight-emphasized);
    line-height: var(--md-sys-typescale-display-small-line-height);
    letter-spacing: var(--md-sys-typescale-display-small-tracking);
  }

  .role {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .socials {
    display: flex;
    align-items: center;
    gap: var(--md-sys-spacing-ui-lg);
    padding-block: var(--md-sys-spacing-ui-sm);
  }

  .social {
    display: inline-flex;
    color: var(--md-sys-color-on-background);
    transition: color 0.2s;
  }

  .social:hover {
    color: var(--md-sys-color-primary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-3xl);
    min-width: 0;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-2xl);
  }

  .section-title {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-section-font);
    font-size: var(--md-sys-typescale-section-size);
    font-weight: var(--md-sys-typescale-section-weight-emphasized);
    line-height: var(--md-sys-typescale-section-line-height);
    letter-spacing: var(--md-sys-typescale-section-tracking);
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--md-sys-spacing-ui-md);
  }

  .demo-grid {
    display: flex;
    gap: var(--md-sys-spacing-body-to-body);
    align-items: stretch;
  }

  .cv-grid {
    display: flex;
    gap: var(--md-sys-spacing-body-to-body);
    align-items: stretch;
  }

  .cv-card {
    flex: 1 0 0;
    min-width: 0;
    padding: var(--md-sys-spacing-body-to-subsection);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-low);
    box-shadow: var(--md-sys-elevation-light-0-5-box-shadow);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-section);

    /* Establishes the sizing context for each card's layout switch. */
    container-type: inline-size;
    container-name: project-list;
  }

  .contact {
    align-items: center;
    text-align: center;
    gap: var(--md-sys-spacing-body-to-subsection);
    padding-top: var(--md-sys-spacing-body-to-section);
  }

  .contact-title {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-display-small-font);
    font-size: var(--md-sys-typescale-display-small-size);
    font-weight: var(--md-sys-typescale-display-small-weight-emphasized);
    line-height: var(--md-sys-typescale-display-small-line-height);
    letter-spacing: var(--md-sys-typescale-display-small-tracking);
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-subsection);
    width: 100%;
    max-width: 520px;
    text-align: left;
  }

  .contact-block {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-subsection-to-body);
  }

  .contact-label {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .contact-label.center {
    text-align: center;
  }

  .socials.center {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
      gap: var(--md-sys-spacing-body-to-section);
    }

    .profile {
      position: static;
    }

    .demo-grid,
    .cv-grid {
      flex-direction: column;
    }
  }
</style>
