const resumeUrl =
  "https://docs.google.com/document/d/e/2PACX-1vTkTaSRuMrBZQGKysG3n6sVdmneoeBud8exiNz8Z0zjCCtpDurUjj-7lRTvvuCcmkjDMptOgK-74TPV/pub";

/** Shown under the name in the sidebar and again in the contact section. */
const socials: { name: LogoName; href: string; label: string }[] = [
  { name: "github", href: "https://github.com/morgankeys", label: "GitHub" },
  {
    name: "linkedin",
    href: "https://www.linkedin.com/in/morgankeys/",
    label: "LinkedIn",
  },
  { name: "x", href: "https://x.com/morgankeys", label: "X" },
  {
    name: "substack",
    href: "https://substack.com/@morgankeys",
    label: "Substack",
  },
  {
    name: "threads",
    href: "https://www.threads.com/@morgankeys",
    label: "Threads",
