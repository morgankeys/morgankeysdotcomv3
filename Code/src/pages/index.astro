---

<BaseLayout>
  <div class="theme-toggle">
    <ThemeToggle client:load />
  </div>

  <main class="home">
    <section class="carousel-section" aria-label="Featured case studies">
      <Carousel client:visible>
        <IntroCard {...introCard} />
        {
          caseStudies.map((study) => (
            <CaseStudyCard {...toCarouselCard(study)} />
          ))
        }
      </Carousel>
    </section>

    <IntroOverlay
      id={INTRO_OVERLAY_ID}
      title={introCard.title}
      subtitle={introCard.subtitle}
      body={introCard.body}
      sections={[
        {
          heading: "Design & AI",
          body: "I believe that AI can help Design as a function reach its full potential. Modern AI tools allow designers to move into higher fidelity outputs—instead of reviewing static mockups or simple click-throughs, designers can now experiment and test at full fidelity. Designers can also build more intuition about the medium they design for, and ultimately create better, more realistic, and more innovative work.",
        },
        {
          heading: "Let's chat",
          body: "If any of this sounds interesting, if you are building complex workflows for specialized industries, or if you're looking to improve your design processes for the AI era, please reach out. I'd love to talk about products, design, AI, and how we realize the potential of this new era in real, everyday workflows.",
        },
      ]}
      image={introHero}
      imageAlt={introCard.imageAlt}
    />
    <BusinessHomeOverlay />
    <AiPrototypingKitOverlay />
    <PublicEdSitesOverlay />
    <CiscoCybersecurityOverlay />
    <AutodeskSsoOverlay />
    <ChartOfAccountsOverlay />
    <ContactOverlay />

    <div class="page">
      <div class="body">
        <aside class="profile">
          <header class="intro">
            <div class="intro-identity">
              <div class="intro-title">
                <h1 class="name">Morgan Keys</h1>
                <p class="role">Product Designer, AI Builder</p>
              </div>
              <nav class="socials" aria-label="Social links">
                {
                  socials.map((s) => (
                    <a class="social" href={s.href} aria-label={s.label}>
                      <Logo name={s.name} />
                    </a>
                  ))
                }
              </nav>
            </div>
            <div class="actions">
              <Button variant="filled" as="a" href={resumeUrl}>
                <svg
                  slot="icon"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M10 13.33 5.83 9.17 7 7.96l2.17 2.16V3.33h1.66v6.79L13 7.96l1.17 1.21L10 13.33ZM5 16.67c-.46 0-.85-.16-1.18-.49-.33-.33-.49-.72-.49-1.18V12.5H5V15h10v-2.5h1.67V15c0 .46-.16.85-.49 1.18-.33.33-.72.49-1.18.49H5Z"
                  ></path>
                </svg>
                Resume
              </Button>
              <Button
                variant="filled"
                as="a"
                href={`#${CONTACT_OVERLAY_ID}`}
                data-overlay-target={CONTACT_OVERLAY_ID}
              >
                <svg
                  slot="icon"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M3.33 16.67c-.46 0-.85-.16-1.18-.49-.33-.33-.49-.72-.49-1.18V5c0-.46.16-.85.49-1.18.33-.33.72-.49 1.18-.49h13.34c.46 0 .85.16 1.18.49.33.33.49.72.49 1.18v10c0 .46-.16.85-.49 1.18-.33.33-.72.49-1.18.49H3.33ZM10 10.83 3.33 6.67V15h13.34V6.67L10 10.83Zm0-1.66L16.67 5H3.33L10 9.17Z"
                  ></path>
                </svg>
                Message
              </Button>
            </div>
          </header>

          <FactsList
            heading="Quick facts:"
            items={quickFacts}
            variant="compact"
          />
        </aside>

        <div class="main-column">
          <section class="section">
            <h2 class="section-title">Case study decks</h2>
            <div class="deck-grid">
              {
                decks.map((d) => (
                  <HorizontalCard
                    title={d.title}
                    subtitle={d.subtitle}
                    href={d.href}
                    image={d.image}
                    imageAlt={d.imageAlt}
                  />
                ))
              }
            </div>
          </section>

          <section class="section" id="demos">
            <h2 class="section-title">Interactive demos</h2>
            <div class="demo-grid">
              {
                demos.map((d) => (
                  <StackedCard
                    title={d.title}
                    subtitle={d.subtitle}
                    body={d.body}
                    image={d.image}
                    imageAlt={d.imageAlt}
                    href={d.href}
                  />
                ))
              }
            </div>
          </section>

          <section class="section">
            <h2 class="section-title">Background</h2>
            <div class="cv-grid">
              <div class="cv-card">
                <FactsList
                  heading="Career path"
                  items={careerPath}
                  variant="card"
                />
              </div>
              <div class="cv-card">
                <FactsList
                  heading="Academic background"
                  items={academics}
                  variant="card"
                />
              </div>
            </div>
          </section>

          <section class="section">
            <h2 class="section-title">Earlier work</h2>
            <div class="project-list">
              {
                projects.map((p) => (
                  <ProjectRow
                    title={p.title}
                    company={p.company}
                    companyLogo={p.companyLogo}
                    layout={p.layout}
                    assets={p.assets}
                  >
                    {p.paragraphs.map((text) => (
                      <p>{text}</p>
                    ))}
                    {p.link &&
                      // Astro renders a line break between </a> and the
                      // suffix as a space, so this line must not be wrapped.
                      // prettier-ignore
                      <p>{p.link.prefix}<a href={p.link.href}>{p.link.label}</a>{p.link.suffix}</p>}
                  </ProjectRow>
                ))
              }
            </div>
          </section>

          <section class="section contact" id="contact">
            <h2 class="contact-title">Ready to chat?</h2>
            <div class="contact-inner">
              <div id="contact-thanks" class="contact-thanks"></div>
              <div class="contact-block">
                <p class="contact-label center">Find me on the socials:</p>
                <nav class="socials center" aria-label="Social links">
                  {
                    socials.map((s) => (
                      <a class="social" href={s.href} aria-label={s.label}>
                        <Logo name={s.name} />
                      </a>
                    ))
                  }
                </nav>
              </div>
              <div class="contact-stack">
                <div id="contact-again" class="contact-again"></div>
                <div class="contact-block contact-message">
                  <p class="contact-label">Or shoot me a message:</p>
                  <ContactForm idPrefix="contact" client:visible />
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /*
   * Anchored to the top of the page, not the viewport, so it scrolls away
   * instead of riding over the sticky sidebar.
   */
  .theme-toggle {
    position: absolute;
    top: var(--md-sys-spacing-ui-sm);
    left: var(--md-sys-spacing-ui-sm);
    z-index: 10;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-section);
    padding-block: var(--md-sys-spacing-body-to-subsection);
  }

  /*
   * Full-bleed carousel: the track spans the viewport so cards scroll off
   * screen, but its inline padding aligns the first/last slide with the
   * max-width page content beside it.
   *
   * 100% (the carousel's width), not 100vw: 100vw counts a classic vertical
   * scrollbar that `.page` does not, which pushed the first card half a
   * scrollbar right of the sidebar.
   */
  .carousel-section :global(.track) {
    padding-inline: max(
      var(--md-sys-spacing-body-to-subsection),
      calc((100% - 1200px) / 2 + var(--md-sys-spacing-body-to-subsection))
    );
    scroll-padding-inline: max(
      var(--md-sys-spacing-body-to-subsection),
      calc((100% - 1200px) / 2 + var(--md-sys-spacing-body-to-subsection))
    );
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--md-sys-spacing-body-to-subsection);
    width: 100%;
  }

  /*
   * The carousel above sets an implicit grid: card-wide columns separated by
   * the carousel gap. The sidebar takes the first column and the main column
   * starts on the second, so both tracks read the tokens the cards
   * (CaseStudyCard, IntroCard) and the carousel track are sized from. At 900px
   * and below the grid is one track and the sidebar goes full width, so there
   * is nothing to line up.
   */
  .body {
    display: grid;
    grid-template-columns: var(--md-sys-spacing-breakpoints-min) 1fr;
    gap: var(--md-sys-spacing-ui-md);
    align-items: start;
  }

  .profile {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-2xl);
    position: sticky;
    top: 1.5rem;

    /*
     * The column gutter is the carousel's tight card gap, so pull the text in
     * by the cards' own inner padding. Its measure then ends where the first
     * card's text does, with breathing room before the main column.
     */
    padding-inline-end: var(--md-sys-spacing-ui-xl);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-xl);
  }

  .intro-identity {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-lg);
  }

  .intro-title {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .name {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-display-small-font);
    font-size: var(--md-sys-typescale-display-small-size);
    font-weight: var(--md-sys-typescale-display-small-weight-emphasized);
    line-height: var(--md-sys-typescale-display-small-line-height);
    letter-spacing: var(--md-sys-typescale-display-small-tracking);
  }

  .role {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .socials {
    display: flex;
    align-items: center;
    gap: var(--md-sys-spacing-ui-lg);
  }

  .social {
    display: inline-flex;
    color: var(--md-sys-color-on-background);
    transition: color 0.2s;
  }

  .social:hover {
    color: var(--md-sys-color-primary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-3xl);
    min-width: 0;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-2xl);
  }

  .section-title {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-section-font);
    font-size: var(--md-sys-typescale-section-size);
    font-weight: var(--md-sys-typescale-section-weight-emphasized);
    line-height: var(--md-sys-typescale-section-line-height);
    letter-spacing: var(--md-sys-typescale-section-tracking);
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    /* Same gutter as the case-study carousel, on both axes. */
    column-gap: var(--md-sys-spacing-ui-md);
    row-gap: var(--md-sys-spacing-ui-md);
  }

  .demo-grid {
    display: flex;
    gap: var(--md-sys-spacing-body-to-body);
    align-items: stretch;
  }

  .cv-grid {
    display: flex;
    gap: var(--md-sys-spacing-body-to-body);
    align-items: stretch;
  }

  .cv-card {
    flex: 1 0 0;
    min-width: 0;
    padding: var(--md-sys-spacing-body-to-subsection);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-low);
