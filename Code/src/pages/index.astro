  {
    title: "OpenGov Network",
    company: "OpenGov, 2015",
    companyLogo: opengovMark,
    layout: "solo",
    assets: [
      {
        image: ogNetwork,
        alt: "OpenGov Network map and searchable list of governments, with a profile of the County of Albany",
      },
    ],
    paragraphs: [
      "Designed a way for governments to find and compare peers on the OpenGov network.",
      "Delivered a new app for the OpenGov platform that strategically leveraged and promoted platform capabilities.",
    ],
    link: {
      prefix: "View a ",
      href: "#demos",
      label: "recreation of it here",
      suffix: ".",
    },
  },
  {
    title: "Hightail Enterprise",
    company: "Hightail (formerly YouSendIt), 2014",
    companyLogo: hightailMark,
    layout: "solo",
    assets: [{ image: hightailReport, alt: "Hightail Enterprise reporting" }],
    paragraphs: [
      "Designed an admin feature that helped enterprise accounts meet e-discovery requirements, giving admins a simple yet powerful way to monitor activity.",
