---
/**
 * IntroOverlay.astro
 *
 * The full bio that IntroCard opens, in the shared Dialog shell. Mirrors the
 * Figma intro overlay (node 445:5094): a tall portrait band with the headline
 * on the photo, then the full body copy below. Hero art is a wide export
 * (src/assets/home/intro/hero.png) sized for the 512×1024 band; the carousel
 * card uses the narrower portrait crop instead. Same Dialog shell as
 * CaseStudyOverlay; only the frame layout differs.
 *
 * The dialog sets `data-theme="dark"`: it always sits on the black scrim, so
 * the Contact me button and focus rings resolve dark-mode color tokens
 * whatever the page's theme. Its own `color` comes from the tone token, not
 * from body, whose color was resolved for the page theme.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.vue";
import Dialog from "./Dialog.astro";
import { cropStyle, croppedRenderWidth, type ImageCrop } from "../lib/crop";
import { CONTACT_OVERLAY_ID } from "../lib/contact";

export interface Props {
  /** Used as the dialog's `id`; IntroCard targets it, and it doubles as a URL hash. */
  id: string;
  title: string;
  subtitle?: string;
  /** Lead paragraph, also shown as the carousel card preview. */
  body: string;
  /** Headed sections that follow the lead, shown only in this overlay. */
  sections?: { heading: string; body: string }[];
  image: ImageMetadata;
  imageAlt?: string;
  crop?: ImageCrop;
}

const {
  id,
  title,
  subtitle,
  body,
  sections = [],
  image,
  imageAlt = "",
  crop,
} = Astro.props;

const OVERLAY_WIDTH = 1024;
const heroWidth = croppedRenderWidth(OVERLAY_WIDTH, crop);
const heroStyle = cropStyle(crop);
---

<Dialog
  id={id}
  class="tone-intro"
  closeLabel={`Close ${title}`}
  data-analytics-overlay="intro"
  data-theme="dark"
>
  <div class="band">
    <Image
      src={image}
      alt={imageAlt}
      widths={[heroWidth, heroWidth * 2]}
      sizes={`(max-width: 640px) 100vw, ${OVERLAY_WIDTH}px`}
      style={heroStyle}
    />
    <div class="headline">
      <h2 class="title" id={`${id}-title`}>{title}</h2>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </div>
  </div>

  <div class="content">
    <p class="body">{body}</p>
    {
      sections.map((section) => (
        <section class="section">
          <h3 class="heading">{section.heading}</h3>
          <p class="body">{section.body}</p>
        </section>
      ))
    }
    <span class="contact" data-overlay-target={CONTACT_OVERLAY_ID}>
      <Button variant="filled" size="md" as="a" href={`#${CONTACT_OVERLAY_ID}`}>
        Contact me
      </Button>
    </span>
  </div>
</Dialog>

<style>
  .band {
    position: relative;
    height: 512px;
    overflow: clip;
  }

  .band :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .headline {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-ui-xs);
    padding: var(--dune-sys-spacing-ui-md) var(--dune-sys-spacing-ui-3xl);
    background: linear-gradient(
      to top,
      var(--md-ref-brand-tone) 0%,
      transparent 100%
    );
  }

  .title {
    margin: 0;
    font-family: var(--dune-sys-typescale-title-font);
    font-size: var(--dune-sys-typescale-title-size);
    font-weight: var(--dune-sys-typescale-title-weight-emphasized);
    line-height: var(--dune-sys-typescale-title-line-height);
    letter-spacing: var(--dune-sys-typescale-title-tracking);
    color: inherit;
  }

  .subtitle {
    margin: 0;
    font-family: var(--dune-sys-typescale-title-medium-font);
    font-size: var(--dune-sys-typescale-title-medium-size);
    font-weight: var(--dune-sys-typescale-title-medium-weight);
    line-height: var(--dune-sys-typescale-title-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-title-medium-tracking);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-ui-xl);
    padding: 0 var(--dune-sys-spacing-ui-3xl) var(--dune-sys-spacing-ui-3xl);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-ui-xs);
  }

  .heading {
    margin: 0;
    font-family: var(--dune-sys-typescale-section-font);
    font-size: var(--dune-sys-typescale-section-size);
    font-weight: var(--dune-sys-typescale-section-weight);
    line-height: var(--dune-sys-typescale-section-line-height);
    letter-spacing: var(--dune-sys-typescale-section-tracking);
    color: inherit;
  }

  .contact {
    align-self: center;
    margin-top: var(--dune-sys-spacing-ui-md);
  }

  .body {
    margin: 0;
    font-family: var(--dune-sys-typescale-body-large-font);
    font-size: var(--dune-sys-typescale-body-large-size);
    font-weight: var(--dune-sys-typescale-body-large-weight);
    line-height: var(--dune-sys-typescale-body-large-line-height);
    letter-spacing: var(--dune-sys-typescale-body-large-tracking);
  }

  /* Bottom sheet (Dialog switches layout at the same width). */
  @media (max-width: 640px) {
    .band {
      height: min(512px, 70vh);
    }

    .headline {
      padding-inline: var(--dune-sys-spacing-ui-xl);
    }

    .content {
      padding: 0 var(--dune-sys-spacing-ui-xl) var(--dune-sys-spacing-ui-3xl);
    }
  }
</style>
