---
/**
 * IntroOverlay.astro
 *
 * The full bio that IntroCard opens, as a native modal <dialog>. Mirrors the
 * Figma intro overlay (node 445:5094): a tall portrait band with the headline
 * on the photo, then the full body copy below. Hero art is a wide export
 * (src/assets/home/intro/hero.png) sized for the 512×1024 band; the carousel
 * card uses the narrower portrait crop instead. Uses the same open/close script
 * and dialog shell as CaseStudyOverlay; only the frame layout differs.
 */
import { Image, type ImageMetadata } from "astro:assets";
import closeIcon from "../assets/icons/close.svg?raw";
import { cropStyle, croppedRenderWidth, type ImageCrop } from "../lib/crop";

export interface Props {
  /** Used as the dialog's `id`; IntroCard targets it, and it doubles as a URL hash. */
  id: string;
  title: string;
  subtitle?: string;
  body: string;
  image: ImageMetadata;
  imageAlt?: string;
  crop?: ImageCrop;
}

const {
  id,
  title,
  subtitle,
  body,
  image,
  imageAlt = "",
  crop,
} = Astro.props;

const OVERLAY_WIDTH = 1024;
const heroWidth = croppedRenderWidth(OVERLAY_WIDTH, crop);
const heroStyle = cropStyle(crop);
---

<dialog
  id={id}
  class="overlay tone-intro"
  aria-labelledby={`${id}-title`}
>
  <div class="card">
    <button
      class="close"
      type="button"
      aria-label={`Close ${title}`}
      data-overlay-close
      autofocus
      set:html={closeIcon}></button>

    <div class="frame">
      <div class="band">
        <Image
          src={image}
          alt={imageAlt}
          widths={[heroWidth, heroWidth * 2]}
          sizes={`(max-width: 640px) 100vw, ${OVERLAY_WIDTH}px`}
          style={heroStyle}
        />
        <div class="headline">
          <h2 class="title" id={`${id}-title`}>{title}</h2>
          {subtitle && <p class="subtitle">{subtitle}</p>}
        </div>
      </div>

      <div class="content">
        <p class="body">{body}</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/case-study-overlay";
</script>

<style>
  .overlay:not([open]) {
    display: none;
  }

  .overlay {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--md-sys-spacing-ui-3xl);
    border: none;
    border-radius: var(--md-sys-shape-corner-none);
    background-color: transparent;
    color: var(--md-ref-brand-on-tone);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    translate: 0 var(--md-sys-spacing-ui-xl);
    transition:
      opacity 0.2s ease,
      translate 0.2s ease,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }

  .overlay::-webkit-scrollbar {
    display: none;
  }

  .overlay:focus {
    outline: none;
  }

  .overlay::backdrop {
    background-color: var(--md-sys-color-scrim);
    opacity: 0.6;
  }

  .overlay[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .overlay[open] {
      opacity: 0;
      translate: 0 var(--md-sys-spacing-ui-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay {
      transition: none;
    }
  }

  .card {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    max-width: var(--md-sys-spacing-breakpoints-lg);
    min-width: 384px;
    margin-block: auto;
  }

  .close {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: var(--md-sys-spacing-ui-xl);
    padding: 0;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: transparent;
    color: var(--md-ref-brand-on-tone);
    cursor: pointer;
  }

  .close::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: currentcolor;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .close:hover::before {
    opacity: 0.08;
  }

  .close:active::before {
    opacity: 0.12;
  }

  .close :global(svg) {
    position: relative;
    display: block;
    width: 32px;
    height: 32px;
  }

  .frame {
    position: relative;
    overflow: clip;
    border-radius: var(--md-sys-shape-corner-extra-extra-large);
    background-color: var(--md-ref-brand-tone);
  }

  .band {
    position: relative;
    height: 512px;
    overflow: clip;
  }

  .band :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .headline {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-ui-xs);
    padding: var(--md-sys-spacing-ui-md) var(--md-sys-spacing-ui-3xl);
    background: linear-gradient(
      to top,
      var(--md-ref-brand-tone) 0%,
      transparent 100%
    );
  }

  .title {
    margin: 0;
    font-family: var(--md-sys-typescale-display-small-font);
    font-size: var(--md-sys-typescale-display-small-size);
    font-weight: var(--md-sys-typescale-display-small-weight-emphasized);
    line-height: var(--md-sys-typescale-display-small-line-height);
    letter-spacing: var(--md-sys-typescale-display-small-tracking);
    color: inherit;
  }

  .subtitle {
    margin: 0;
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .content {
    padding: 0 var(--md-sys-spacing-ui-3xl) var(--md-sys-spacing-ui-3xl);
  }

  .body {
    margin: 0;
    font-family: var(--md-sys-typescale-body-large-font);
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-body-large-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
  }

  @media (max-width: 640px) {
    .overlay {
      padding: var(--md-sys-spacing-ui-4xl) 0 0;
    }

    .card {
      flex: 1 0 auto;
      display: flex;
      flex-direction: column;
      min-width: 0;
      max-width: none;
      margin-block: 0;
    }

    .frame {
      flex: 1 0 auto;
      border-radius: var(--md-sys-shape-corner-extra-extra-large)
        var(--md-sys-shape-corner-extra-extra-large)
        var(--md-sys-shape-corner-none) var(--md-sys-shape-corner-none);
    }

    .band {
      height: min(512px, 70vh);
    }

    .headline {
      padding-inline: var(--md-sys-spacing-ui-xl);
    }

    .content {
      padding: 0 var(--md-sys-spacing-ui-xl) var(--md-sys-spacing-ui-3xl);
    }
  }
</style>
