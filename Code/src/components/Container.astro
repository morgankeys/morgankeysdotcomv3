---
/**
 * Container.astro
 *
 * Horizontal content wrapper with max-width and responsive padding.
 */

export interface Props {
  size?: "default" | "wide" | "narrow";
  class?: string;
}

const { size = "default", class: className } = Astro.props;
---

<div class:list={["container", `container--${size}`, className]}>
  <slot />
</div>

<style>
  .container {
    max-width: 80rem;
    margin-inline: auto;

    /* 20px has no ui step. Snapped up to ui-xl (24px). */
    padding-inline: var(--md-sys-spacing-ui-xl);
  }

  .container--narrow {
    max-width: 60rem;
  }

  .container--wide {
    max-width: 100rem;
  }

  @media (min-width: 768px) {
    .container {
      /* 40px has no ui step. Snapped up to ui-3xl (48px). */
      padding-inline: var(--md-sys-spacing-ui-3xl);
    }
  }
</style>
