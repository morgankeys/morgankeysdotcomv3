---
/**
 * Container.astro
 *
 * Horizontal content wrapper with max-width and responsive padding.
 */

export interface Props {
  size?: "default" | "wide" | "narrow";
  class?: string;
}

const { size = "default", class: className } = Astro.props;
---

<div class:list={["container", `container--${size}`, className]}>
  <slot />
</div>

<style>
  .container {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--md-sys-spacing-body-to-body);
  }

  .container--narrow {
    max-width: 60rem;
  }

  .container--wide {
    max-width: 100rem;
  }

  @media (min-width: 768px) {
    .container {
      padding-inline: var(--md-sys-spacing-body-to-section);
    }
  }
</style>
