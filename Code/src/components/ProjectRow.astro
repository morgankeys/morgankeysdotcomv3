---
/**
 * ProjectRow.astro
 *
 * One "Earlier work" entry: text column (title, description, company) beside
 * an AssetGrid. On narrow viewports the text stacks above the media. The
 * description is provided via the default slot (so it can contain multiple
 * paragraphs and inline links).
 */
import type { ImageMetadata } from "astro";
import AssetGrid from "./AssetGrid.astro";
import type { AssetGridLayout, AssetItem } from "./AssetGrid.astro";
import CompanyLabel from "./CompanyLabel.astro";

export interface Props {
  title: string;
  company: string;
  companyLogo?: ImageMetadata;
  layout: AssetGridLayout;
  assets: AssetItem[];
}

const { title, company, companyLogo, layout, assets } = Astro.props;
---

<article class="project">
  <div class="grid">
    <div class="info">
      <h3 class="title">{title}</h3>
      <div class="desc"><slot /></div>
      <CompanyLabel label={company} logo={companyLogo} />
    </div>
    <AssetGrid layout={layout} assets={assets} class="assets" />
  </div>
</article>

<style>
  .project {
    padding: var(--dune-sys-spacing-ui-xl);
    border-radius: var(--dune-sys-shape-corner-extra-extra-large);
    background-color: var(--dune-sys-color-surface-container-low);
    box-shadow: var(--dune-sys-elevation-light-0-5-box-shadow);
    width: 100%;
    margin-inline: auto;

    /*
     * Horizontal layout design range: breakpoint-sm (640px) → breakpoint-lg
     * (1024px). The card fills its container fluidly and is capped at
     * breakpoint-lg. A hard min-width of breakpoint-sm is intentionally NOT set:
     * these cards sit inside a narrower content column (the 340px sidebar grid),
     * so forcing 640px would cause horizontal overflow.
     */
    max-width: var(--dune-sys-spacing-breakpoints-lg);
  }

  .grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: var(--dune-sys-spacing-ui-xl);
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-ui-md);
  }

  .title {
    margin: 0;
    color: var(--dune-sys-color-on-surface);
    font-family: var(--dune-sys-typescale-title-medium-font);
    font-size: var(--dune-sys-typescale-title-medium-size);
    font-weight: var(--dune-sys-typescale-title-medium-weight-emphasized);
    line-height: var(--dune-sys-typescale-title-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-title-medium-tracking);
  }

  .desc {
    color: var(--dune-sys-color-on-surface);
    font-family: var(--dune-sys-typescale-body-medium-font);
    font-size: var(--dune-sys-typescale-body-medium-size);
    font-weight: var(--dune-sys-typescale-body-medium-weight);
    line-height: var(--dune-sys-typescale-body-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-body-medium-tracking);
  }

  .desc :global(p) {
    margin: 0 0 var(--dune-sys-spacing-ui-md);
  }

  .desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .desc :global(a) {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  /* Screenshots sit on the card surface; the tile shadow reads as a second edge. */
  .project :global(.elevation-container) {
    border-radius: var(--dune-sys-shape-corner-extra-large);
    box-shadow: none;
  }

  .project :global(.elevation-image img) {
    filter: none;
  }

  /*
   * Switch to the vertical layout when the card's own width drops below
   * breakpoint-sm (640px) — the card, not the viewport, decides. A container
   * query is used because these cards sit in a narrow sidebar column, so the
   * card can be well under 640px even on a wide viewport.
   */
  @container project-list (max-width: 639.98px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
