---
/**
 * ProjectRow.astro
 *
 * One "Older projects" entry: text column (title, description, company) beside
 * an AssetGrid. On narrow viewports the text stacks above the media. The
 * description is provided via the default slot (so it can contain multiple
 * paragraphs and inline links).
 */
import type { ImageMetadata } from "astro:assets";
import AssetGrid from "./AssetGrid.astro";
import type { AssetGridLayout, AssetItem } from "./AssetGrid.astro";
import CompanyLabel from "./CompanyLabel.astro";

export interface Props {
  title: string;
  company: string;
  companyLogo?: ImageMetadata;
  layout: AssetGridLayout;
  assets: AssetItem[];
}

const { title, company, companyLogo, layout, assets } = Astro.props;
---

<article class="project">
  <div class="grid">
    <div class="info">
      <h3 class="title">{title}</h3>
      <div class="desc"><slot /></div>
      <CompanyLabel label={company} logo={companyLogo} />
    </div>
    <AssetGrid layout={layout} assets={assets} class="assets" />
  </div>
</article>

<style>
  .project {
    padding: var(--md-sys-shape-corner-extra-large);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-low);
    box-shadow: var(--md-sys-elevation-light-0-5-box-shadow);
  }

  .grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1.5rem;
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-shape-corner-medium);
  }

  .title {
    margin: 0;
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-title-large-font);
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: var(--md-sys-typescale-title-large-weight-emphasized);
    line-height: var(--md-sys-typescale-title-large-line-height);
    letter-spacing: var(--md-sys-typescale-title-large-tracking);
  }

  .desc {
    color: var(--md-sys-color-on-background);
    font-family: var(--md-sys-typescale-body-large-font);
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-body-large-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
  }

  .desc :global(p) {
    margin: 0 0 var(--md-sys-shape-corner-medium);
  }

  .desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .desc :global(a) {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
