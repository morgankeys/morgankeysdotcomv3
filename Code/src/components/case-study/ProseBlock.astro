---
/**
 * ProseBlock.astro
 *
 * A section of a case study: an optional heading, body copy, and an optional
 * supporting image. Covers the three arrangements the Figma overlay uses
 * (node 401:3722):
 *  - `beside`:  copy on the left, a fixed-width asset on the right
 *  - `stacked`: copy above a wide, centered asset
 *  - no asset:  copy only, full width
 *
 * In a `beside` row the heading sits above both columns, so the image starts
 * level with the first line of copy. The copy stays at least `breakpoints-min`
 * (320px) wide; when the section is too narrow for that plus the asset, the
 * image goes below the copy.
 *
 * Unlike Prose.astro, type here inherits its color from the overlay's tone
 * rather than pinning `on-surface` — the copy sits on a brand color, so a dark
 * tone needs light text and vice versa. The image caption does the same, so it
 * stays readable on every tone.
 */
import type { ImageMetadata } from "astro";
import Asset from "../Asset.astro";
import Caption from "../Caption.astro";

export interface Props {
  heading?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Shown under the image. Pass one whenever `image` is set. */
  imageCaption?: string;
  /** Ignored when there is no image. Defaults to `beside`. */
  layout?: "beside" | "stacked";
  /** See Asset: `contain` for images that must not be cropped. */
  fit?: "cover" | "contain";
  /** See Asset: `image` for transparent assets that carry their own shape. */
  imageElevation?: "container" | "image";
  class?: string;
}

const {
  heading,
  image,
  imageAlt = "",
  imageCaption,
  layout = "beside",
  fit = "cover",
  imageElevation = "container",
  class: className,
} = Astro.props;

const arrangement = image ? layout : "text-only";
---

<section class:list={["block", arrangement, className]}>
  <div class="layout">
    {heading && <h3 class="heading">{heading}</h3>}
    <div class="copy"><slot /></div>

    {
      image && (
        <figure class:list={["media", imageElevation === "image" && "shaped"]}>
          <Asset
            image={image}
            alt={imageAlt}
            fit={fit}
            elevation={imageElevation}
            zoomable={imageElevation !== "image"}
            sizes={
              layout === "stacked"
                ? "(max-width: 640px) 100vw, 700px"
                : "(max-width: 640px) 100vw, 400px"
            }
          />
          {imageCaption && <Caption>{imageCaption}</Caption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  /*
   * One column by default: heading, copy, then any asset. `minmax(0, 1fr)`
   * lets long words and wide images shrink instead of widening the dialog.
   */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  /*
   * A beside section is its own container, so the two-column switch follows
   * its width, not the viewport: the overlay is inset, so a wide window can
   * still hold a narrow column.
   */
  .block.beside {
    container-type: inline-size;
  }

  .heading {
    margin: 0 0 var(--md-sys-spacing-section-to-body);
    font-family: var(--md-sys-typescale-section-font);
    font-size: var(--md-sys-typescale-section-size);
    font-weight: var(--md-sys-typescale-section-weight);
    line-height: var(--md-sys-typescale-section-line-height);
    letter-spacing: var(--md-sys-typescale-section-tracking);
    color: inherit;
  }

  /* Slotted copy: styled through :global, since it belongs to the caller. */
  .copy :global(p) {
    margin: 0;
    font-family: var(--md-sys-typescale-body-font);
    font-size: var(--md-sys-typescale-body-size);
    font-weight: var(--md-sys-typescale-body-weight);
    line-height: var(--md-sys-typescale-body-line-height);
    letter-spacing: var(--md-sys-typescale-body-tracking);
  }

  .copy :global(p + p) {
    margin-top: var(--md-sys-spacing-body-to-body);
  }

  /*
   * One step under the whole copy, not between paragraphs. It only applies
   * when the copy is the bottom of the section: text on its own, or beside an
   * image. When the image sits below the copy, the image is the bottom and
   * this space would open a gap above it.
   */
  .block.text-only .copy {
    padding-bottom: var(--md-sys-spacing-ui-xl);
  }

  /*
   * Links take the tone's foreground, like the copy around them; the global
   * `primary` link color can't hold contrast on every brand tone. The
   * underline, from global.css, is what marks them as links.
   */
  .copy :global(a) {
    color: inherit;
  }

  /* Below the copy, in every arrangement until a beside row has room. */
  .media {
    margin-top: var(--md-sys-spacing-body-to-body);
  }

  .block.stacked .media {
    justify-self: center;
    width: 100%;
    max-width: 700px;
  }

  .media :global(.asset) {
    aspect-ratio: 16 / 9;
  }

  /*
   * Room for breakpoints-min of copy, the body-to-body gap, and a 400px
   * asset: 320 + 20 + 400 = 740. The heading spans both columns' row above,
   * so the asset's top lines up with the copy's first line, not the heading.
   */
  @container (min-width: 740px) {
    .block.beside .layout {
      grid-template-columns: minmax(0, 1fr) 400px;
      grid-template-areas:
        "heading heading"
        "copy media";
      column-gap: var(--md-sys-spacing-body-to-body);
    }

    .block.beside .heading {
      grid-area: heading;
    }

    .block.beside .copy {
      grid-area: copy;
      padding-bottom: var(--md-sys-spacing-ui-xl);
    }

    .block.beside .media {
      grid-area: media;
      margin-top: 0;
    }
  }

  /*
   * Below that, a shaped asset (the circular portrait) spans the column, inset
   * by ui-3xl. Padding is on the wrapper so the asset stays square. Space
   * under the block is the overlay's body-to-section gap.
   */
  @container (max-width: 739px) {
    .block.beside .media.shaped {
      padding-inline: var(--md-sys-spacing-ui-3xl);
    }

    .block.beside .media :global(.elevation-image) {
      aspect-ratio: 1;
    }
  }
</style>
