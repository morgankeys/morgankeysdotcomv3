---
/**
 * ProseBlock.astro
 *
 * A section of a case study: an optional heading, body copy, and an optional
 * supporting image. Covers the three arrangements the Figma overlay uses
 * (node 401:3722):
 *  - `beside`:  copy on the left, a fixed-width asset on the right
 *  - `stacked`: copy above a wide, centered asset
 *  - no asset:  copy only, full width
 *
 * A `beside` row keeps the copy at least `breakpoints-min` (320px) wide. When
 * the section is too narrow for that plus the asset, the image wraps below.
 *
 * Unlike Prose.astro, type here inherits its color from the overlay's tone
 * rather than pinning `on-surface` — the copy sits on a brand color, so a dark
 * tone needs light text and vice versa.
 */
import type { ImageMetadata } from "astro";
import Asset from "../Asset.astro";

export interface Props {
  heading?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Ignored when there is no image. Defaults to `beside`. */
  layout?: "beside" | "stacked";
  /** See Asset: `contain` for images that must not be cropped. */
  fit?: "cover" | "contain";
  /** See Asset: `image` for transparent assets that carry their own shape. */
  imageElevation?: "container" | "image";
  class?: string;
}

const {
  heading,
  image,
  imageAlt = "",
  layout = "beside",
  fit = "cover",
  imageElevation = "container",
  class: className,
} = Astro.props;

const arrangement = image ? layout : "text-only";
---

<section class:list={["block", arrangement, className]}>
  <div class="text">
    {heading && <h3 class="heading">{heading}</h3>}
    <div class="copy"><slot /></div>
  </div>

  {
    image && (
      <div class:list={["media", imageElevation === "image" && "shaped"]}>
        <Asset
          image={image}
          alt={imageAlt}
          fit={fit}
          elevation={imageElevation}
          zoomable={imageElevation !== "image"}
          sizes={
            layout === "stacked"
              ? "(max-width: 640px) 100vw, 700px"
              : "(max-width: 640px) 100vw, 400px"
          }
        />
      </div>
    )
  }
</section>

<style>
  .block {
    display: flex;
    gap: var(--md-sys-spacing-body-to-body);
  }

  /*
   * The section is the container so the wrap follows its width, not the
   * viewport — the overlay is inset, so a wide window can still hold a narrow
   * column.
   */
  .block.beside {
    container-type: inline-size;
    flex-flow: row wrap;
    align-items: center;
  }

  .block.stacked,
  .block.text-only {
    flex-direction: column;
    align-items: center;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  /*
   * Copy stays at least breakpoints-min. `min(100%, …)` lets the column
   * itself be narrower than that (a phone) without widening the dialog.
   * The large grow factor keeps extra space in the copy, so the asset stays
   * near its 400px basis until the row wraps.
   */
  .block.beside .text {
    flex: 100 1 var(--md-sys-spacing-breakpoints-min);
    min-width: min(100%, var(--md-sys-spacing-breakpoints-min));
  }

  .heading {
    margin: 0 0 var(--md-sys-spacing-body-to-body);
    font-family: var(--md-sys-typescale-section-font);
    font-size: var(--md-sys-typescale-section-size);
    font-weight: var(--md-sys-typescale-section-weight);
    line-height: var(--md-sys-typescale-section-line-height);
    letter-spacing: var(--md-sys-typescale-section-tracking);
    color: inherit;
  }

  /* Slotted copy: styled through :global, since it belongs to the caller. */
  .copy :global(p) {
    margin: 0;
    font-family: var(--md-sys-typescale-body-font);
    font-size: var(--md-sys-typescale-body-size);
    font-weight: var(--md-sys-typescale-body-weight);
    line-height: var(--md-sys-typescale-body-line-height);
    letter-spacing: var(--md-sys-typescale-body-tracking);
  }

  .copy :global(p + p) {
    margin-top: var(--md-sys-spacing-body-to-body);
  }

  /*
   * Basis is a width, and only on the row. A column flex container would
   * treat 400px as a height. The asset wraps onto its own line once 320px of
   * copy, the body-to-body gap, and this 400px no longer fit; flex-grow then
   * fills that line. `min(100%, 400px)` avoids a min-content wider than the
   * dialog.
   */
  .block.beside .media {
    flex: 1 1 400px;
    max-width: 100%;
    min-width: min(100%, 400px);
  }

  .block.stacked .media {
    width: 100%;
    max-width: 700px;
  }

  .media :global(.asset) {
    aspect-ratio: 16 / 9;
  }

  /*
   * Same threshold the row wraps at: breakpoints-min + body-to-body + 400.
   * 320 + 20 + 400 = 740. A shaped asset (the circular portrait) then spans
   * the column, inset by ui-3xl. Padding is on the wrapper so the asset stays
   * square. Space under the block is the overlay's body-to-section gap.
   */
  @container (max-width: 739px) {
    .media.shaped {
      padding-inline: var(--md-sys-spacing-ui-3xl);
    }

    .media :global(.elevation-image) {
      aspect-ratio: 1;
    }
  }
</style>
