---
/**
 * EndMark.astro
 *
 * Closes a case study's story: the company's logo in a small white badge,
 * centered, with an optional sign-off line under it (Autodesk SSO, Figma
 * node 564:552).
 *
 * The logo keeps its own brand colors, so the badge is always white: the
 * theme-invariant `brand-on-dark`, not a surface token that turns dark in
 * dark mode. The label already names the company, so the logo is hidden
 * from assistive tech. The label inherits the overlay tone's foreground,
 * like the copy around it.
 */
export interface Props {
  /** Raw SVG markup for the logo (import it with `?raw`). */
  logo: string;
  /** A short sign-off under the logo. */
  label?: string;
  class?: string;
}

const { logo, label, class: className } = Astro.props;
---

<div class:list={["end-mark", className]}>
  <span class="badge" aria-hidden="true" set:html={logo} />
  {label && <p class="label">{label}</p>}
</div>

<style>
  .end-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--dune-sys-spacing-ui-md);
    padding-block: var(--dune-sys-spacing-ui-md);
    text-align: center;
  }

  .badge {
    display: flex;
    padding: var(--dune-sys-spacing-ui-md);
    border-radius: var(--dune-sys-shape-corner-small);
    background-color: var(--md-ref-brand-on-dark);
  }

  .badge :global(svg) {
    display: block;
  }

  .label {
    margin: 0;
    font-family: var(--dune-sys-typescale-body-font);
    font-size: var(--dune-sys-typescale-body-size);
    font-weight: var(--dune-sys-typescale-body-weight);
    line-height: var(--dune-sys-typescale-body-line-height);
    letter-spacing: var(--dune-sys-typescale-body-tracking);
  }
</style>
