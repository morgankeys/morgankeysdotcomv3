---
/**
 * Banner.astro
 *
 * Call-to-action card inside a case study, pointing at something that lives
 * outside the site — a slide deck, a live prototype (Figma nodes 246:1577 and
 * 233:4525). Optional leading thumbnail.
 *
 * It sits on `inverse-surface` rather than the case study's tone, so it reads
 * as a distinct object regardless of which tone surrounds it.
 */
import { Image, type ImageMetadata } from "astro:assets";
import Button from "../Button.vue";

export interface Props {
  title: string;
  body: string;
  href: string;
  actionLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * Close the enclosing case-study overlay when the action is taken. Used when
   * the href is an in-page target rather than an external URL.
   */
  closeOverlay?: boolean;
  /**
   * Dialog id to open instead of navigating. The overlay script also closes
   * the case study this banner sits in.
   */
  overlayTarget?: string;
  class?: string;
}

const {
  title,
  body,
  href,
  actionLabel,
  image,
  imageAlt = "",
  closeOverlay = false,
  overlayTarget,
  class: className,
} = Astro.props;
---

<div class:list={["banner", className]}>
  {
    image && (
      <div class="thumbnail">
        <Image src={image} alt={imageAlt} widths={[150, 300]} sizes="150px" />
      </div>
    )
  }

  <div class="text">
    <p class="title">{title}</p>
    <p class="body">{body}</p>
  </div>

  {
    overlayTarget ? (
      <span data-overlay-target={overlayTarget}>
        <Button variant="filled" as="a" href={href}>
          {actionLabel}
        </Button>
      </span>
    ) : closeOverlay ? (
      <span data-overlay-close>
        <Button variant="filled" as="a" href={href}>
          {actionLabel}
        </Button>
      </span>
    ) : (
      <Button variant="filled" as="a" href={href}>
        {actionLabel}
      </Button>
    )
  }
</div>

<style>
  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--md-sys-spacing-body-to-body);
    padding: var(--md-sys-spacing-body-to-body);
    border-radius: var(--md-sys-shape-corner-large-increased);
    background-color: var(--md-sys-color-inverse-surface);
    color: var(--md-sys-color-inverse-on-surface);
  }

  .thumbnail {
    flex: 0 0 150px;
    overflow: clip;
    border-radius: var(--md-sys-shape-corner-medium);
  }

  .thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
  }

  /*
   * Copy stays at least breakpoints-min, then wraps under the thumbnail.
   * `min(100%, …)` keeps a phone-width banner from widening the dialog.
   */
  .text {
    flex: 1 1 var(--md-sys-spacing-breakpoints-min);
    min-width: min(100%, var(--md-sys-spacing-breakpoints-min));
  }

  .title {
    margin: 0;
    font-family: var(--md-sys-typescale-title-large-font);
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: var(--md-sys-typescale-title-large-weight-emphasized);
    line-height: var(--md-sys-typescale-title-large-line-height);
    letter-spacing: var(--md-sys-typescale-title-large-tracking);
  }

  .body {
    margin: var(--md-sys-spacing-subsection-to-body) 0 0;
    font-family: var(--md-sys-typescale-body-medium-font);
    font-size: var(--md-sys-typescale-body-medium-size);
    font-weight: var(--md-sys-typescale-body-medium-weight);
    line-height: var(--md-sys-typescale-body-medium-line-height);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
  }
</style>
