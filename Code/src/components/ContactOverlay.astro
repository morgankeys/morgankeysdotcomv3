---
/**
 * ContactOverlay.astro
 *
 * The contact form as a modal, opened by the header Message button and by
 * in-study "Contact me" banners. Same Dialog shell as CaseStudyOverlay, with
 * a plain surface-container card instead of a brand tone, a narrower card,
 * and a content-sized bottom sheet so a short form doesn't fill the screen.
 */
import { CONTACT_OVERLAY_ID } from "../lib/contact";
import ContactForm from "./ContactForm.vue";
import Dialog from "./Dialog.astro";

export interface Props {
  /** Dialog id. Defaults to the shared contact overlay id. */
  id?: string;
  title?: string;
}

const { id = CONTACT_OVERLAY_ID, title = "What do you want to chat about?" } =
  Astro.props;
---

<Dialog
  id={id}
  closeLabel={`Close ${title}`}
  width="sm"
  surface="container"
  sheet="hug"
  autofocusClose={false}
  data-analytics-overlay="contact"
>
  <div class="body">
    <ContactForm
      idPrefix={id}
      title={title}
      compact
      autofocus
      showDone
      client:load
    />
  </div>
</Dialog>

<style>
  /* Top padding clears the close button in the card's corner. */
  .body {
    padding: var(--dune-sys-spacing-ui-5xl) var(--dune-sys-spacing-ui-3xl)
      var(--dune-sys-spacing-ui-3xl);
  }

  /* Bottom sheet (Dialog switches layout at the same width). */
  @media (max-width: 640px) {
    .body {
      padding-inline: var(--dune-sys-spacing-ui-xl);
    }
  }
</style>
