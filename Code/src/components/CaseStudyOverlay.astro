---
/**
 * CaseStudyOverlay.astro
 *
 * The full case study that a CaseStudyCard opens, as a native modal <dialog>.
 * Mirrors the Figma "case study card" overlay component (minimal/deck variant
 * node 246:1578, long-form variant node 401:3722) — the two designs are the
 * same frame with different blocks stacked inside it, so this component owns
 * the frame and the blocks in ./case-study/ compose the body.
 *
 * Frame, top to bottom: a 256px hero image, a gradient fading the hero into the
 * tone color, then the toned content column.
 *
 * `tone` resolves the same `--md-ref-brand-tone` / `--md-ref-brand-on-tone`
 * properties the card uses (see src/styles/brand.css), which is what keeps a
 * card and the overlay it opens in matching colors.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import closeIcon from "../assets/icons/close.svg?raw";
import type { CardTone } from "./CaseStudyCard.astro";
import { cropStyle, croppedRenderWidth, type ImageCrop } from "../lib/crop";

export interface Props {
  /** Used as the dialog's `id`; cards target it, and it doubles as a URL hash. */
  id: string;
  tone: CardTone;
  title: string;
  /** Company and date, e.g. "Boardable | Summer 2025". */
  subtitle?: string;
  /** Lead paragraph, set larger than body copy. */
  standfirst?: string;
  image: ImageMetadata;
  imageAlt?: string;
  crop?: ImageCrop;
}

const {
  id,
  tone,
  title,
  subtitle,
  standfirst,
  image,
  imageAlt = "",
  crop,
} = Astro.props;

// The hero spans the overlay's full 1024px maximum; a zoomed crop renders wider
// still, so size the srcset to the crop rather than to the frame.
const OVERLAY_WIDTH = 1024;
const heroWidth = croppedRenderWidth(OVERLAY_WIDTH, crop);
const heroStyle = cropStyle(crop);
---

<dialog
  id={id}
  class:list={["overlay", `tone-${tone}`]}
  aria-labelledby={`${id}-title`}
>
  <div class="card">
    <button
      class="close"
      type="button"
      aria-label={`Close ${title}`}
      data-overlay-close
      autofocus
      set:html={closeIcon}></button>

    <div class="frame">
      <div class="hero" aria-hidden={imageAlt ? undefined : "true"}>
        <Image
          src={image}
          alt={imageAlt}
          widths={[heroWidth, heroWidth * 2]}
          sizes={`(max-width: 640px) 100vw, ${OVERLAY_WIDTH}px`}
          style={heroStyle}
        />
      </div>

      <div class="fade" aria-hidden="true"></div>

      <div class="content">
        <header class="headline">
          <h2 class="title" id={`${id}-title`}>{title}</h2>
          {subtitle && <p class="subtitle">{subtitle}</p>}
          {standfirst && <p class="standfirst">{standfirst}</p>}
        </header>

        <div class="body">
          <slot />
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/case-study-overlay";
</script>

<style>
  /*
   * The dialog is a full-viewport scrollport, not a height-capped card.
   * Padding is the 3xl margin: the card hugs its content and can extend past
   * the bottom of the screen; scrolling the dialog (not the page) reveals it.
   *
   * Flex + margin-block: auto on `.card` vertically centers short overlays;
   * when the card is taller than the viewport the auto margins collapse and
   * the card sits flush under the top padding, as before.
   *
   * Width lives on `.card` so leftover space around the card is still the
   * dialog — clicks there close it, same as the backdrop.
   */
  .overlay:not([open]) {
    display: none;
  }

  .overlay {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--md-sys-spacing-ui-3xl);
    border: none;
    border-radius: var(--md-sys-shape-corner-none);
    background-color: transparent;
    color: var(--md-ref-brand-on-tone);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;

    /*
     * Open transition. `display` and `overlay` need `allow-discrete` to animate
     * out, and @starting-style supplies the state to animate in from.
     */
    opacity: 0;
    translate: 0 var(--md-sys-spacing-ui-xl);
    transition:
      opacity 0.2s ease,
      translate 0.2s ease,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }

  .overlay::-webkit-scrollbar {
    display: none;
  }

  /*
   * The dialog takes focus when opened, but it isn't an interactive control —
   * the ring belongs on the close button, which is the autofocus target.
   */
  .overlay:focus {
    outline: none;
  }

  .overlay::backdrop {
    background-color: var(--md-sys-color-scrim);
    opacity: 0.6;
  }

  .overlay[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .overlay[open] {
      opacity: 0;
      translate: 0 var(--md-sys-spacing-ui-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay {
      transition: none;
    }
  }

  /*
   * Positions the close button against the visual card. The button is absolute
   * on this wrapper (not sticky on the dialog) so it scrolls away with the card.
   *
   * It can't live inside `.frame`: overflow: clip there would clip the control.
   */
  .card {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    max-width: var(--md-sys-spacing-breakpoints-lg);
    min-width: 384px;
    margin-block: auto;
  }

  .close {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;

    /* Centers the icon 48px from the frame's corner, as in the design. */
    margin: var(--md-sys-spacing-ui-xl);
    padding: 0;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: transparent;
    color: var(--md-ref-brand-on-tone);
    cursor: pointer;
  }

  .close::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: currentcolor;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .close:hover::before {
    opacity: 0.08;
  }

  .close:active::before {
    opacity: 0.12;
  }

  .close :global(svg) {
    position: relative;
    display: block;
    width: 32px;
    height: 32px;
  }

  /* The card: content-sized, clipped to the extra-extra-large corner. */
  .frame {
    position: relative;
    overflow: clip;
    border-radius: var(--md-sys-shape-corner-extra-extra-large);
    background-color: var(--md-ref-brand-tone);
  }

  .hero {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 256px;
    overflow: clip;
  }

  /*
   * Absolutely positioned so a crop (width/height/left/top from the `crop`
   * prop) can reproduce Figma's zoom + pan. With no crop it falls back to a
   * `cover` fill of the hero band.
   */
  .hero :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Occupies the hero's height in flow, and fades it into the content below. */
  .fade {
    position: relative;
    height: 256px;
    background: linear-gradient(
      to top,
      var(--md-ref-brand-tone) 0%,
      transparent 100%
    );
  }

  .content {
    position: relative;
    padding: 0 var(--md-sys-spacing-ui-3xl) var(--md-sys-spacing-body-to-section);
  }

  .headline {
    padding-bottom: var(--md-sys-spacing-body-to-section);
  }

  .title {
    margin: 0;
    font-family: var(--md-sys-typescale-headline-large-font);
    font-size: var(--md-sys-typescale-headline-large-size);
    font-weight: var(--md-sys-typescale-headline-large-weight-emphasized);
    line-height: var(--md-sys-typescale-headline-large-line-height);
    letter-spacing: var(--md-sys-typescale-headline-large-tracking);
    color: inherit;
  }

  .subtitle {
    margin: var(--md-sys-spacing-section-to-body) 0 0;
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .standfirst {
    margin: var(--md-sys-spacing-title-to-standfirst) 0 0;
    font-family: var(--md-sys-typescale-body-large-font);
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-body-large-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
  }

  /* Section rhythm for the slotted blocks. */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-body-to-section);
  }

  /*
   * Mobile sheet: 64px of the page stays visible above the card, the card
   * runs to the side and bottom edges, and only the top corners stay rounded.
   * The card grows to the viewport so a short study still meets the bottom.
   */
  @media (max-width: 640px) {
    .overlay {
      padding: var(--md-sys-spacing-ui-4xl) 0 0;
    }

    .card {
      flex: 1 0 auto;
      display: flex;
      flex-direction: column;
      min-width: 0;
      max-width: none;
      margin-block: 0;
    }

    .frame {
      flex: 1 0 auto;
      border-radius: var(--md-sys-shape-corner-extra-extra-large)
        var(--md-sys-shape-corner-extra-extra-large)
        var(--md-sys-shape-corner-none) var(--md-sys-shape-corner-none);
    }

    .content {
      padding: 0 var(--md-sys-spacing-ui-xl) var(--md-sys-spacing-body-to-section);
    }
  }
</style>
