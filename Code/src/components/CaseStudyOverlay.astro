---
/**
 * CaseStudyOverlay.astro
 *
 * The full case study that a CaseStudyCard opens, in the shared Dialog shell
 * (a bottom sheet at phone width). Mirrors the Figma "case study card" overlay component (minimal/deck variant
 * node 246:1578, long-form variant node 401:3722) — the two designs are the
 * same frame with different blocks stacked inside it, so this component owns
 * the frame's layout and the blocks in ./case-study/ compose the body.
 *
 * Frame, top to bottom: a 256px hero image, a gradient fading the hero into the
 * tone color, then the toned content column.
 *
 * `tone` resolves the same `--md-ref-brand-tone` / `--md-ref-brand-on-tone`
 * properties the card uses (see src/styles/brand.css), which is what keeps a
 * card and the overlay it opens in matching colors.
 *
 * With `summary`, the standfirst, highlights, and anything in the `summary`
 * slot (a study's prototype Banner, say) share one card under the subtitle.
 *
 * `data-route` and `data-route-title` let case-study-overlay.ts put the
 * study's own URL and title in the address bar while it is open.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CardTone } from "./CaseStudyCard.astro";
import { cropStyle, croppedRenderWidth, type ImageCrop } from "../lib/crop";
import { studyPath, type CaseStudyHighlight } from "../lib/case-studies";
import { pageTitle } from "../lib/site";
import Highlights from "./case-study/Highlights.astro";
import Dialog from "./Dialog.astro";

export interface Props {
  /**
   * Used as the dialog's `id`; cards target it, it names the study's route
   * (`/work/<id>/`), and it still works as a URL hash.
   */
  id: string;
  /** Former ids; a URL hash naming one still opens this overlay. */
  aliases?: string[];
  /** Renders nothing: the study is a draft this build hides. */
  hidden?: boolean;
  tone: CardTone;
  title: string;
  /** Company and date, e.g. "Boardable | Summer 2025". */
  subtitle?: string;
  /** Lead paragraph, set larger than body copy in the summary card. */
  standfirst?: string;
  /** One line on the role, under the standfirst (in the summary card or not). */
  role?: string;
  /** Headline results in the summary card; see case-study/Highlights. */
  highlights?: CaseStudyHighlight[];
  /** Set the standfirst, and any highlights, in a "Summary" card. */
  summary?: boolean;
  image: ImageMetadata;
  imageAlt?: string;
  crop?: ImageCrop;
}

const {
  id,
  aliases,
  hidden = false,
  tone,
  title,
  subtitle,
  standfirst,
  role,
  highlights,
  summary = Boolean(highlights?.length),
  image,
  imageAlt = "",
  crop,
} = Astro.props;

// The hero spans the overlay's full 1024px maximum; a zoomed crop renders wider
// still, so size the srcset to the crop rather than to the frame.
const OVERLAY_WIDTH = 1024;
const heroWidth = croppedRenderWidth(OVERLAY_WIDTH, crop);
const heroStyle = cropStyle(crop);
---

{
  !hidden && (
    <Dialog
      id={id}
      class={`tone-${tone}`}
      closeLabel={`Close ${title}`}
      data-analytics-overlay="case_study"
      data-route={studyPath(id)}
      data-route-title={pageTitle(title)}
      data-route-aliases={aliases?.join(" ")}
    >
      <div class="hero" aria-hidden={imageAlt ? undefined : "true"}>
        <Image
          src={image}
          alt={imageAlt}
          widths={[heroWidth, heroWidth * 2]}
          sizes={`(max-width: 640px) 100vw, ${OVERLAY_WIDTH}px`}
          style={heroStyle}
        />
      </div>

      <div class="fade" aria-hidden="true" />

      <div class="content">
        <header class="headline">
          <h2 class="title" id={`${id}-title`}>
            {title}
          </h2>
          {subtitle && <p class="subtitle">{subtitle}</p>}
          {summary ? (
            <section class="summary" aria-labelledby={`${id}-summary`}>
              <h3 class="summary-title" id={`${id}-summary`}>
                Summary
              </h3>
              {standfirst && <p class="standfirst">{standfirst}</p>}
              {role && <p class="role">{role}</p>}
              {highlights?.length ? <Highlights items={highlights} /> : null}
              <slot name="summary" />
            </section>
          ) : (
            <>
              {standfirst && <p class="standfirst lead">{standfirst}</p>}
              {role && <p class="role">{role}</p>}
            </>
          )}
        </header>

        <div class="body">
          <slot />
        </div>
      </div>
    </Dialog>
  )
}

<style>
  .hero {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 256px;
    overflow: clip;
  }

  /*
   * Absolutely positioned so a crop (width/height/left/top from the `crop`
   * prop) can reproduce Figma's zoom + pan. With no crop it falls back to a
   * `cover` fill of the hero band.
   */
  .hero :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Occupies the hero's height in flow, and fades it into the content below. */
  .fade {
    position: relative;
    height: 256px;
    background: linear-gradient(
      to top,
      var(--md-ref-brand-tone) 0%,
      transparent 100%
    );
  }

  .content {
    position: relative;
    padding: 0 var(--dune-sys-spacing-ui-3xl) var(--dune-sys-spacing-ui-3xl);
  }

  .headline {
    padding-bottom: var(--dune-sys-spacing-body-to-section);
  }

  .title {
    margin: 0;
    font-family: var(--dune-sys-typescale-title-font);
    font-size: var(--dune-sys-typescale-title-size);
    font-weight: var(--dune-sys-typescale-title-weight);
    line-height: var(--dune-sys-typescale-title-line-height);
    letter-spacing: var(--dune-sys-typescale-title-tracking);
    color: inherit;
  }

  .subtitle {
    margin: var(--dune-sys-spacing-section-to-body) 0 0;
    font-family: var(--dune-sys-typescale-title-medium-font);
    font-size: var(--dune-sys-typescale-title-medium-size);
    font-weight: var(--dune-sys-typescale-title-medium-weight);
    line-height: var(--dune-sys-typescale-title-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-title-medium-tracking);
  }

  /*
   * The summary card: the standfirst and any highlights, set apart so a
   * reader who stops here still has the role and the results. Same surface,
   * corner, and foreground as Banner, so it reads as a distinct object on any
   * tone. Studies without `summary` keep a plain standfirst under the
   * subtitle (`.lead`).
   */
  .summary {
    margin: var(--dune-sys-spacing-ui-2xl) 0 0;
    padding: var(--dune-sys-spacing-ui-2xl);
    border-radius: var(--dune-sys-shape-corner-large-increased);
    background-color: var(--dune-sys-color-inverse-surface);
    color: var(--dune-sys-color-inverse-on-surface);
  }

  /*
   * A Banner in the summary slot is already on the card's surface, so it
   * drops its own and becomes a row set off from the copy above. Its title
   * steps down to title-medium so it ranks below the card's "Summary".
   */
  .summary :global(.banner) {
    margin-top: var(--dune-sys-spacing-body-to-section);
    padding: 0;
    border-radius: 0;
    background-color: transparent;
  }

  .summary :global(.banner .title) {
    font-family: var(--dune-sys-typescale-title-medium-font);
    font-size: var(--dune-sys-typescale-title-medium-size);
    font-weight: var(--dune-sys-typescale-title-medium-weight-emphasized);
    line-height: var(--dune-sys-typescale-title-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-title-medium-tracking);
  }

  .summary-title {
    margin: 0;
    font-family: var(--dune-sys-typescale-section-font);
    font-size: var(--dune-sys-typescale-section-size);
    font-weight: var(--dune-sys-typescale-section-weight);
    line-height: var(--dune-sys-typescale-section-line-height);
    letter-spacing: var(--dune-sys-typescale-section-tracking);
    color: inherit;
  }

  .standfirst {
    margin: var(--dune-sys-spacing-section-to-body) 0 0;
    font-family: var(--dune-sys-typescale-standfirst-font);
    font-size: var(--dune-sys-typescale-standfirst-size);
    font-weight: var(--dune-sys-typescale-standfirst-weight);
    line-height: var(--dune-sys-typescale-standfirst-line-height);
    letter-spacing: var(--dune-sys-typescale-standfirst-tracking);
  }

  /*
   * The role line sits ui-md under the standfirst, in the title-small style,
   * whether or not the study has a summary card.
   */
  .role {
    margin: var(--dune-sys-spacing-ui-md) 0 0;
    font-family: var(--dune-sys-typescale-title-small-font);
    font-size: var(--dune-sys-typescale-title-small-size);
    font-weight: var(--dune-sys-typescale-title-small-weight);
    line-height: var(--dune-sys-typescale-title-small-line-height);
    letter-spacing: var(--dune-sys-typescale-title-small-tracking);
  }

  .standfirst.lead {
    margin-top: var(--dune-sys-spacing-title-to-standfirst);
  }

  /* Section rhythm for the slotted blocks. */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--dune-sys-spacing-body-to-section);
  }

  /* Bottom sheet (Dialog switches layout at the same width). */
  @media (max-width: 640px) {
    .content {
      padding: 0 var(--dune-sys-spacing-ui-xl) var(--dune-sys-spacing-ui-3xl);
    }

    .summary {
      padding: var(--dune-sys-spacing-ui-xl);
    }
  }
</style>
