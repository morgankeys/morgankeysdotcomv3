---
/**
 * CompanyLabel.astro
 *
 * Small company attribution: a 14px brand mark + caption label ("Company, Year").
 * Used inside project rows.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  label: string;
  logo?: ImageMetadata;
  class?: string;
}

const { label, logo, class: className } = Astro.props;
---

<span class:list={["company", className]}>
  {logo && <Image class="mark" src={logo} alt="" width={14} height={14} />}
  <span class="type-caption label">{label}</span>
</span>

<style>
  .company {
    display: inline-flex;
    align-items: center;
    gap: var(--md-sys-spacing-ui-xs);
    color: var(--md-sys-color-on-surface-variant);
  }

  .mark {
    width: 14px;
    height: 14px;
    object-fit: contain;
    border-radius: var(--md-sys-shape-corner-extra-small);
  }

  .label {
    white-space: nowrap;
  }
</style>
