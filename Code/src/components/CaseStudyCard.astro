---
/**
 * CaseStudyCard.astro
 *
 * A tall, image-backed carousel slide for case studies: brand-toned scrim,
 * fade, and a content block with headline, subtitle, body, and a "Read more"
 * CTA. The opening "Hi, I'm Morgan" slide is IntroCard.astro instead.
 *
 * Art is exported already cropped to the card's 320px width. The card splits
 * evenly between the image band and the content block; the image fills its
 * half with object-fit cover and fades into the tone below.
 *
 * The per-slide brand color is chosen via the `tone` prop, which resolves
 * `--md-ref-brand-tone` / `--md-ref-brand-on-tone` (see src/styles/brand.css).
 * The overlay this card opens reads the same two properties, so the card and
 * its case study can never drift apart in color.
 */
import { Image, type ImageMetadata } from "astro:assets";
import type { CardTone } from "../lib/tone";

export type { CardTone };

export interface Props {
  tone: CardTone;
  title: string;
  subtitle?: string;
  body: string;
  href: string;
  /** Exported already cropped to the card's 320px width. */
  image: ImageMetadata;
  imageAlt?: string;
  ctaLabel?: string;
  /**
   * `id` of the CaseStudyOverlay this card opens. When set, the card becomes an
   * overlay trigger; `href` should point at the same overlay so the card still
   * works as a plain anchor before the script runs (or if it never does).
   */
  overlayId?: string;
}

const {
  tone,
  title,
  subtitle,
  body,
  href,
  image,
  imageAlt = "",
  ctaLabel = "Read more...",
  overlayId,
} = Astro.props;

// The card frame is a fixed 320px wide, so the image renders at that width
// plus a 2x variant for the srcset.
const CARD_WIDTH = 320;
---

<a
  class:list={["card", `tone-${tone}`]}
  href={href}
  data-overlay-target={overlayId}
>
  <div class="background">
    <Image
      src={image}
      alt={imageAlt}
      widths={[CARD_WIDTH, CARD_WIDTH * 2]}
      sizes={`${CARD_WIDTH}px`}
    />
    <div class="fade" aria-hidden="true"></div>
  </div>

  <div class="scrim" aria-hidden="true"></div>

  <div class="container">
    <div class="content">
      <div class="headline">
        <p class="title">{title}</p>
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </div>
      <div class="text">
        <p class="body">{body}</p>
        <span class="cta">{ctaLabel}</span>
      </div>
    </div>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 320px;
    height: 600px;
    overflow: clip;
    border-radius: var(--md-sys-shape-corner-extra-extra-large);

    /* Shows below a pre-cropped image, which fades into it. */
    background-color: var(--md-ref-brand-tone);
    text-decoration: none;
    color: var(--md-ref-brand-on-tone);
  }

  .background {
    position: absolute;
    inset: 0 0 50%;
    overflow: clip;
  }

  .background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-color: var(--md-ref-brand-tone);
    opacity: 0.5;
  }

  .container {
    position: absolute;
    inset: 50% 0 0;
    display: flex;
    flex-direction: column;
  }

  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 128px;
    background: linear-gradient(
      to top,
      var(--md-ref-brand-tone) 0%,
      transparent 100%
    );
  }

  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    gap: var(--md-sys-spacing-ui-lg);
    padding: 0 var(--md-sys-spacing-ui-xl) var(--md-sys-spacing-ui-xl);
    background-color: var(--md-ref-brand-tone);
  }

  .headline {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .title {
    margin: 0;
    font-family: var(--md-sys-typescale-headline-medium-font);
    font-size: var(--md-sys-typescale-headline-medium-size);
    font-weight: var(--md-sys-typescale-headline-medium-weight-emphasized);
    line-height: var(--md-sys-typescale-headline-medium-line-height);
    letter-spacing: var(--md-sys-typescale-headline-medium-tracking);
  }

  .subtitle {
    margin: 0;
    font-family: var(--md-sys-typescale-title-medium-font);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
  }

  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .body {
    margin: 0;
    flex-shrink: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--md-sys-typescale-body-large-font);
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-body-large-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
  }

  .cta {
    flex-shrink: 0;
    margin-top: auto;
    font-family: var(--md-sys-typescale-body-large-font);
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
  }

  .card:hover .cta {
    text-decoration: underline;
  }
</style>
