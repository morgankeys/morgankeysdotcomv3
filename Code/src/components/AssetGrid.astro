---
/**
 * AssetGrid.astro
 *
 * Arranges project media into layouts matching the Figma "Asset grid" component
 * (node 204:1114), keeping a 16:9 footprint that scales with its column:
 *  - solo:         one full-bleed asset (Layout A)
 *  - duo:          two equal assets side by side (Layout B)
 *  - primary-pair: one large asset + a stacked pair of squares (Layout C)
 *
 * Every tile is a `cover` container, so pre-cropped images fill correctly at
 * any responsive size. Track sizing is driven by the grid's fixed 16:9 height
 * (never by content) so the stacked squares can't blow the row height out.
 */
import type { ImageMetadata } from "astro:assets";
import Asset from "./Asset.astro";

export type AssetGridLayout = "solo" | "duo" | "primary-pair";

export interface AssetItem {
  image: ImageMetadata;
  alt?: string;
}

export interface Props {
  layout: AssetGridLayout;
  assets: AssetItem[];
  class?: string;
}

const { layout, assets, class: className } = Astro.props;
---

<div class:list={["asset-grid", layout, className]}>
  {layout === "solo" && <Asset image={assets[0].image} alt={assets[0].alt} class="fill" />}

  {
    layout === "duo" &&
      assets.slice(0, 2).map((a) => <Asset image={a.image} alt={a.alt} class="cell" />)
  }

  {
    layout === "primary-pair" && (
      <>
        <Asset image={assets[0].image} alt={assets[0].alt} class="primary" />
        <Asset image={assets[1].image} alt={assets[1].alt} class="square" />
        <Asset image={assets[2].image} alt={assets[2].alt} class="square" />
      </>
    )
  }
</div>

<style>
  .asset-grid {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    gap: var(--md-sys-spacing-ui-sm);
  }

  .asset-grid.solo {
    grid-template-columns: 1fr;
  }

  .asset-grid.duo {
    grid-template-columns: 1fr 1fr;
  }

  /*
   * Primary spans both rows; the two squares stack in the trailing column.
   * The trailing column is sized explicitly to the row height so the squares
   * stay square: the grid is 16:9, so each row is (width * 9/16 - gap) / 2, and
   * column percentages resolve against the grid's width. (An `auto` column
   * shrink-wrapping the squares is unreliable — Safari sizes it from the
   * images' intrinsic width and squeezes the primary to nothing.)
   */
  .asset-grid.primary-pair {
    grid-template-columns:
      minmax(0, 1fr)
      calc((100% * 9 / 16 - var(--md-sys-spacing-ui-sm)) / 2);
    grid-template-rows: 1fr 1fr;
  }

  .asset-grid :global(.asset) {
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
  }

  .asset-grid.primary-pair :global(.primary) {
    grid-row: 1 / 3;
  }

</style>
