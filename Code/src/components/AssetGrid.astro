---
/**
 * AssetGrid.astro
 *
 * Arranges project media into one of three layouts (matching the Figma
 * "Asset grid" variants), keeping a 16:9 footprint that scales with its column:
 *  - solo:         one full-bleed asset
 *  - duo:          two equal assets side by side
 *  - primary-pair: one large asset + a stacked pair of squares
 */
import type { ImageMetadata } from "astro:assets";
import Asset from "./Asset.astro";

export type AssetGridLayout = "solo" | "duo" | "primary-pair";

export interface AssetItem {
  image: ImageMetadata;
  alt?: string;
}

export interface Props {
  layout: AssetGridLayout;
  assets: AssetItem[];
  class?: string;
}

const { layout, assets, class: className } = Astro.props;
---

<div class:list={["asset-grid", layout, className]}>
  {layout === "solo" && <Asset image={assets[0].image} alt={assets[0].alt} class="fill" />}

  {
    layout === "duo" &&
      assets.slice(0, 2).map((a) => <Asset image={a.image} alt={a.alt} class="cell" />)
  }

  {
    layout === "primary-pair" && (
      <>
        <Asset image={assets[0].image} alt={assets[0].alt} class="primary" />
        <div class="pair">
          <Asset image={assets[1].image} alt={assets[1].alt} class="square" />
          <Asset image={assets[2].image} alt={assets[2].alt} class="square" />
        </div>
      </>
    )
  }
</div>

<style>
  .asset-grid {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    gap: var(--md-sys-shape-corner-medium);
  }

  .asset-grid :global(.asset) {
    height: 100%;
  }

  .fill {
    flex: 1 0 0;
    width: 100%;
  }

  .cell {
    flex: 1 0 0;
    min-width: 0;
  }

  .primary {
    flex: 1 0 0;
    min-width: 0;
  }

  .pair {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-shape-corner-medium);
    height: 100%;
    aspect-ratio: 1 / 2;
  }

  .pair :global(.square) {
    flex: 1 0 0;
    min-height: 0;
    aspect-ratio: 1;
  }
</style>
