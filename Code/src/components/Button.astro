---
/**
 * Button.astro
 *
 * Semantic button component with token-driven styling.
 * Supports optional leading icon via named slot.
 */

export interface Props {
  variant?: "filled" | "outlined" | "text";
  as?: "button" | "a";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  variant = "filled",
  as: Tag = "button",
  href,
  type = "button",
  class: className,
} = Astro.props;

const isLink = Tag === "a";
const hasIcon = Astro.slots.has("icon");
---

{
  isLink ? (
    <a href={href} class:list={["button", `button--${variant}`, className]}>
      {hasIcon && <span class="button__icon"><slot name="icon" /></span>}
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={["button", `button--${variant}`, className]}
    >
      {hasIcon && <span class="button__icon"><slot name="icon" /></span>}
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--md-sys-spacing-ui-sm);
    padding: var(--md-sys-spacing-quote-to-attribution)
      var(--md-sys-spacing-list-to-next-block);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    font-family: var(--md-sys-typescale-label-large-font);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    line-height: var(--md-sys-typescale-label-large-line-height);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .button__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(.button__icon svg) {
    width: 18px;
    height: 18px;
    color: currentcolor;
  }

  .button--filled {
    background-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .button--filled:hover {
    background-color: var(--md-sys-color-primary);
    box-shadow: 0 1px 3px var(--md-sys-color-shadow);
  }

  .button--filled:active {
    background-color: var(--md-sys-color-primary);
  }

  .button--outlined {
    background-color: transparent;
    color: var(--md-sys-color-primary);
    border: 1px solid var(--md-sys-color-outline);
  }

  .button--outlined:hover {
    background-color: var(--md-sys-color-state-layers-primary-opacity-08);
    border-color: var(--md-sys-color-primary);
  }

  .button--outlined:active {
    background-color: var(--md-sys-color-state-layers-primary-opacity-10);
  }

  .button--text {
    background-color: transparent;
    color: var(--md-sys-color-primary);
  }

  .button--text:hover {
    background-color: var(--md-sys-color-state-layers-primary-opacity-08);
  }

  .button--text:active {
    background-color: var(--md-sys-color-state-layers-primary-opacity-10);
  }
</style>
