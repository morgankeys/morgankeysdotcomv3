import autodeskSignIn from "../../assets/case-studies/autodesk-sso/autodesk-sign-in.png";
import linkedAccountsExample from "../../assets/case-studies/autodesk-sso/linked-accounts-example.png";
import twinCredentialsExample from "../../assets/case-studies/autodesk-sso/twin-credentials-example.png";
import oneAccountExample from "../../assets/case-studies/autodesk-sso/one-account-example.png";
import crossroads from "../../assets/case-studies/autodesk-sso/crossroads.png";
