---
/**
 * Autodesk SSO case study overlay (Figma node 402:4077).
 *
 * The minimal variant: headline, a lead paragraph, and a banner out to the
 * full deck. Opened by the `ochre` carousel card.
 *
 * NOTE: the lead paragraph is placeholder copy — it is lorem ipsum in the
 * design too. The design's byline also reads "Boardable | Summer 2025", which
 * contradicts the carousel card — the card's "Autodesk | 2020" is used
 * instead.
 */
import CaseStudyOverlay from "../CaseStudyOverlay.astro";
import Banner from "../case-study/Banner.astro";
import { CASE_STUDY_IDS } from "../../lib/case-studies";
import hero from "../../assets/case-studies/autodesk-sso/hero.png";
---

<CaseStudyOverlay
  id={CASE_STUDY_IDS.autodeskSso}
  tone="ochre"
  title="Autodesk SSO"
  subtitle="Autodesk | 2020"
  standfirst="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."
  image={hero}
  imageAlt="BuildingConnected sign-in screen used in Autodesk SSO"
>
  <Banner
    title="Case study deck"
    body="View a detailed case-study deck on this project."
    href="#"
    actionLabel="View deck"
  />
</CaseStudyOverlay>
