---
/**
 * Autodesk SSO case study overlay (Figma node 402:4077).
 *
 * The minimal variant: headline, a lead paragraph, and the full deck played
 * inline (a banner out to it on phones). Opened by the `ochre` carousel card.
 *
 * Header, copy, and hero come from the registry entry so this study reads the
 * same on the card and in the overlay; only the body blocks live here. The
 * design's byline reads "Boardable | Summer 2025"; the registry keeps the
 * carousel's "Autodesk | 2020".
 */
import CaseStudyOverlay from "../CaseStudyOverlay.astro";
import DeckEmbed from "../case-study/DeckEmbed.astro";
import { autodeskSso, toOverlayProps } from "../../lib/case-studies";
import deckCover from "../../assets/case-studies/autodesk-sso/deck-cover.png";
---

<CaseStudyOverlay {...toOverlayProps(autodeskSso)}>
  <DeckEmbed
    title="Autodesk SSO case study deck"
    href="https://www.figma.com/deck/pNOmkOSvKYFaItMa8HDUWm/-case-study--Autodesk-ID?node-id=0-1&t=DjttmneWz6wHGAKZ-1"
    cover={deckCover}
    coverAlt="Title slide: Autodesk ID, Morgan Keys, Autodesk Construction Cloud, beside a map of the sign-up flow screens"
  />
</CaseStudyOverlay>
