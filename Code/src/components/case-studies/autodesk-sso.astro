import platformDiagram from "../../assets/case-studies/autodesk-sso/platform-diagram.png";
import accPlatform from "../../assets/case-studies/autodesk-sso/acc-platform.png";
import autodeskSignIn from "../../assets/case-studies/autodesk-sso/autodesk-sign-in.png";
import linkedAccountsExample from "../../assets/case-studies/autodesk-sso/linked-accounts-example.png";
import twinCredentialsExample from "../../assets/case-studies/autodesk-sso/twin-credentials-example.png";
import oneAccountExample from "../../assets/case-studies/autodesk-sso/one-account-example.png";
import crossroads from "../../assets/case-studies/autodesk-sso/crossroads.png";
import oneAccountPrototype from "../../assets/case-studies/autodesk-sso/one-account-prototype.png";
import synthesisWorkshop from "../../assets/case-studies/autodesk-sso/synthesis-workshop.png";
import itbOriginal from "../../assets/case-studies/autodesk-sso/itb-original.png";
import scenarioMatrix from "../../assets/case-studies/autodesk-sso/scenario-matrix.png";
import itbAutodeskSignUp from "../../assets/case-studies/autodesk-sso/itb-autodesk-sign-up.png";
