---
/**
 * Cisco Cybersecurity case study overlay (Figma node 402:4079).
 *
 * The minimal variant: headline, a lead paragraph, and a banner out to the
 * full deck. Opened by the `rust` carousel card.
 *
 * Header, copy, and hero come from the registry entry so this study reads the
 * same on the card and in the overlay; only the body blocks live here. The
 * design's byline reads "Boardable | Summer 2025"; the registry keeps the
 * carousel's "DesignMap | 2023".
 */
import CaseStudyOverlay from "../CaseStudyOverlay.astro";
import Banner from "../case-study/Banner.astro";
import { ciscoCybersecurity, toOverlayProps } from "../../lib/case-studies";
---

<CaseStudyOverlay {...toOverlayProps(ciscoCybersecurity)}>
  <Banner
    title="Case study deck"
    body="View a detailed case-study deck on this project."
    href="#"
    actionLabel="View deck"
  />
</CaseStudyOverlay>
