---
/**
 * Business Home case study overlay (Figma node 402:4076).
 *
 * The minimal variant: headline, a lead paragraph, and a banner to contact.
 * Opened by the `night` carousel card.
 *
 * Header, copy, and hero come from the registry entry so this study reads the
 * same on the card and in the overlay; only the body blocks live here.
 */
import CaseStudyOverlay from "../CaseStudyOverlay.astro";
import Banner from "../case-study/Banner.astro";
import { CONTACT_OVERLAY_ID } from "../../lib/contact";
import { businessHome, toOverlayProps } from "../../lib/case-studies";
---

<CaseStudyOverlay {...toOverlayProps(businessHome)}>
  <Banner
    title="Case study in progress"
    body="Reach out to learn more about this project."
    href={`#${CONTACT_OVERLAY_ID}`}
    actionLabel="Contact me"
    overlayTarget={CONTACT_OVERLAY_ID}
  />
</CaseStudyOverlay>
