 * card.
 *
 * Header, copy, and hero come from the registry entry so this study reads the
 * same on the card and in the overlay; only the body blocks live here. Links
 * in the copy come from the earlier draft, since Figma text carries none.
 */
import CaseStudyOverlay from "../CaseStudyOverlay.astro";
import ProseBlock from "../case-study/ProseBlock.astro";
import EndMark from "../case-study/EndMark.astro";
