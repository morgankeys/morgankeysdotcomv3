import businessHome from "../../assets/case-studies/ai-prototyping-kit/business-home.png";
import aiCodeEditor from "../../assets/case-studies/ai-prototyping-kit/ai-code-editor.png";
import singleHtmlFile from "../../assets/case-studies/ai-prototyping-kit/single-html-file.png";
import kitFolders from "../../assets/case-studies/ai-prototyping-kit/kit-folders.webp";
import guardrails from "../../assets/case-studies/ai-prototyping-kit/guardrails.png";
import mockData from "../../assets/case-studies/ai-prototyping-kit/mock-data.png";
import vite from "../../assets/case-studies/ai-prototyping-kit/vite.png";
import vueHomepage from "../../assets/case-studies/ai-prototyping-kit/vue-homepage.png";
