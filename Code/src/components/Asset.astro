---
/**
 * Asset.astro
 *
 * A single rounded, elevated media tile used inside an AssetGrid. Mirrors the
 * Figma "Asset" component (node 229:1897): a rounded, clipped container whose
 * image is object-fit: cover, so a pre-cropped image always fills the tile even
 * as its dimensions change with the responsive layout.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  image: ImageMetadata;
  alt?: string;
  sizes?: string;
  /**
   * `cover` (default) fills the tile, cropping as needed — right for
   * pre-cropped screenshots. `contain` fits the whole image inside the tile
   * against its background, for images that must not be cropped (portraits,
   * diagrams).
   */
  fit?: "cover" | "contain";
  /**
   * Where elevation is applied. `container` (default) is the rounded tile —
   * background plus box-shadow. `image` is for assets with their own shape and
   * transparency (e.g. a circular portrait): no tile chrome, and a drop-shadow
   * that follows the image alpha.
   */
  elevation?: "container" | "image";
  /** Opens a full-screen, zoomable view of the image on click. Default false — Asset is
   * reused for card thumbnails, backgrounds, and portraits, most of which are already a
   * link or another trigger. Pass true only where the image is standalone content (a
   * case-study screenshot), never a logo, avatar, or background. See ImageZoomOverlay. */
  zoomable?: boolean;
  class?: string;
}

const {
  image,
  alt = "",
  sizes = "(max-width: 760px) 90vw, 40vw",
  fit = "cover",
  elevation = "container",
  zoomable = false,
  class: className,
} = Astro.props;
---

<div
  class:list={["asset", `fit-${fit}`, `elevation-${elevation}`, className]}
  data-zoom-trigger={zoomable ? true : undefined}
  role={zoomable ? "button" : undefined}
  tabindex={zoomable ? 0 : undefined}
  aria-label={zoomable ? `Zoom in on ${alt}` : undefined}
>
  <Image src={image} alt={alt} widths={[300, 600, 900]} sizes={sizes} />
</div>

<style>
  .asset {
    position: relative;
  }

  .asset[data-zoom-trigger] {
    cursor: zoom-in;
  }

  .asset[data-zoom-trigger]:focus-visible {
    outline: 3px solid var(--md-sys-color-secondary);
    outline-offset: 2px;
  }

  .elevation-container {
    overflow: clip;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-high);
    box-shadow: var(--md-sys-elevation-light-0-5-box-shadow);
  }

  .elevation-image {
    overflow: visible;
    background-color: transparent;
  }

  .elevation-image :global(img) {
    filter: var(--md-sys-elevation-light-0-5-drop-shadow);
  }

  .asset :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fit-cover :global(img) {
    object-fit: cover;
  }

  .fit-contain :global(img) {
    object-fit: contain;
  }
</style>
