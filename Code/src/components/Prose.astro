---
/**
 * Prose.astro
 *
 * Content wrapper applying vertical rhythm and typographic styling to editorial content.
 * Use around blocks of markdown or hand-written prose. The element rules are
 * `:global()` under the scoped `.prose`, so they reach slotted content.
 */

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
  }

  .prose > :global(* + *) {
    margin-top: var(--dune-sys-spacing-body-to-body);
  }

  .prose > :global(h2) {
    margin-top: var(--dune-sys-spacing-body-to-section);
    margin-bottom: var(--dune-sys-spacing-section-to-body);
  }

  .prose > :global(h3) {
    margin-top: var(--dune-sys-spacing-body-to-subsection);
    margin-bottom: var(--dune-sys-spacing-subsection-to-body);
  }

  .prose :global(h2) {
    font-family: var(--dune-sys-typescale-section-font);
    font-size: var(--dune-sys-typescale-section-size);
    font-weight: var(--dune-sys-typescale-section-weight);
    line-height: var(--dune-sys-typescale-section-line-height);
    letter-spacing: var(--dune-sys-typescale-section-tracking);
    color: var(--dune-sys-color-on-surface);
  }

  .prose :global(h3) {
    font-family: var(--dune-sys-typescale-subsection-font);
    font-size: var(--dune-sys-typescale-subsection-size);
    font-weight: var(--dune-sys-typescale-subsection-weight);
    line-height: var(--dune-sys-typescale-subsection-line-height);
    letter-spacing: var(--dune-sys-typescale-subsection-tracking);
    color: var(--dune-sys-color-on-surface);
  }

  .prose :global(p) {
    font-family: var(--dune-sys-typescale-body-font);
    font-size: var(--dune-sys-typescale-body-size);
    font-weight: var(--dune-sys-typescale-body-weight);
    line-height: var(--dune-sys-typescale-body-line-height);
    letter-spacing: var(--dune-sys-typescale-body-tracking);
    color: var(--dune-sys-color-on-surface);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--dune-sys-spacing-ui-2xl);
  }

  .prose :global(li) {
    font-family: var(--dune-sys-typescale-list-item-font);
    font-size: var(--dune-sys-typescale-list-item-size);
    font-weight: var(--dune-sys-typescale-list-item-weight);
    line-height: var(--dune-sys-typescale-list-item-line-height);
    letter-spacing: var(--dune-sys-typescale-list-item-tracking);
  }

  .prose :global(li + li) {
    margin-top: var(--dune-sys-spacing-list-item-to-list-item);
  }

  .prose :global(ul + *),
  .prose :global(ol + *) {
    margin-top: var(--dune-sys-spacing-list-to-next-block);
  }

  /* Same as PullQuote's `rule` variant: Dune's 2px rule and 24px gap. */
  .prose :global(blockquote) {
    margin-block: var(--dune-sys-spacing-quote-outer);
    margin-inline: 0;
    padding-inline-start: var(--dune-sys-spacing-ui-xl);
    border-inline-start: 2px solid var(--dune-sys-color-primary);
    font-family: var(--dune-sys-typescale-quote-font);
    font-size: var(--dune-sys-typescale-quote-size);
    font-weight: var(--dune-sys-typescale-quote-weight);
    line-height: var(--dune-sys-typescale-quote-line-height);
    letter-spacing: var(--dune-sys-typescale-quote-tracking);
    color: var(--dune-sys-color-on-surface);
  }

  .prose :global(code) {
    font-family: var(--dune-sys-typescale-code-inline-font);
    font-size: var(--dune-sys-typescale-code-inline-size);
    font-weight: var(--dune-sys-typescale-code-inline-weight);
    line-height: var(--dune-sys-typescale-code-inline-line-height);
    letter-spacing: var(--dune-sys-typescale-code-inline-tracking);
    padding: var(--dune-sys-spacing-ui-xs) var(--dune-sys-spacing-ui-sm);
    background-color: var(--dune-sys-color-surface-container);
    border-radius: var(--dune-sys-shape-corner-extra-small);
  }

  .prose :global(pre) {
    padding: var(--dune-sys-spacing-ui-2xl);
    background-color: var(--dune-sys-color-surface-container);
    border-radius: var(--dune-sys-shape-corner-medium);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(a) {
    color: var(--dune-sys-color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .prose :global(a:hover) {
    background-color: var(--dune-sys-color-state-layers-primary-opacity-08);
  }
</style>
