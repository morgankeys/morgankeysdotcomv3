---
/**
 * EnvironmentBadge.astro
 *
 * Names the environment in a pill so a tab is never mistaken for the live
 * site: "Development" on the dev server, "Preview" on a feature branch's
 * Vercel preview, "Staging" on staging. Production has no badge. The stage
 * comes from `deployStage` in src/lib/env.ts.
 *
 * Fixed to a bottom corner and non-interactive, to stay clear of page content
 * and never swallow a click. In development it sits bottom-left, because the
 * dev server's Figma capture button owns the bottom-right corner.
 */

import { deployStage, deployStageLabel } from "../lib/env";

const label = deployStageLabel[deployStage];
---

{
  deployStage !== "production" && (
    <div
      class="environment-badge"
      data-component="EnvironmentBadge"
      data-stage={deployStage}
      role="status"
      aria-label={`${label} environment`}
    >
      {label}
    </div>
  )
}

<style>
  .environment-badge {
    position: fixed;
    right: var(--dune-sys-spacing-ui-md);
    bottom: var(--dune-sys-spacing-ui-md);
    z-index: 9999;
    padding: var(--dune-sys-spacing-ui-xs) var(--dune-sys-spacing-ui-md);
    border-radius: var(--dune-sys-shape-corner-full);
    background-color: var(--dune-sys-color-surface-container);
    box-shadow: var(--dune-sys-elevation-light-0-5-box-shadow);
    color: var(--dune-sys-color-on-surface-variant);
    font-family: var(--dune-sys-typescale-label-medium-font);
    font-size: var(--dune-sys-typescale-label-medium-size);
    font-weight: var(--dune-sys-typescale-label-medium-weight);
    line-height: var(--dune-sys-typescale-label-medium-line-height);
    letter-spacing: var(--dune-sys-typescale-label-medium-tracking);
    text-transform: uppercase;
    pointer-events: none;
  }

  .environment-badge[data-stage="development"] {
    right: auto;
    left: var(--dune-sys-spacing-ui-md);
  }
</style>
