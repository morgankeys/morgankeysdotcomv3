---
/**
 * Section.astro
 *
 * Semantic top-level section wrapper providing consistent vertical rhythm.
 */

export interface Props {
  as?: "section" | "div" | "article" | "aside" | "nav";
  class?: string;
}

const { as: Tag = "section", class: className } = Astro.props;
---

<Tag class:list={["section", className]}>
  <slot />
</Tag>

<style>
  .section {
    /* 40px has no ui step. Snapped up to ui-3xl (48px). */
    padding-block: var(--dune-sys-spacing-ui-3xl);
  }

  /* First section has less top padding */
  .section:first-child {
    /* 20px has no ui step. Snapped up to ui-xl (24px). */
    padding-block-start: var(--dune-sys-spacing-ui-xl);
  }
</style>
