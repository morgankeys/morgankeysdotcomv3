---
/**
 * BaseLayout.astro
 *
 * Foundation layout providing <head>, global CSS, theme data attributes, and slots.
 * All pages extend this layout for consistent site-wide structure.
 */

import '../styles/global.css';
import '../styles/brand.css';
import StagingBanner from '../components/StagingBanner.astro';
import ImageZoomOverlay from '../components/ImageZoomOverlay.astro';
import type { ImageMetadata } from 'astro';
import { isStaging } from '../lib/env';
import defaultShareImage from '../assets/og/og-image.png';

/** Full title for the home page, and for any page that sets no `title`. */
const SITE_TITLE = "Morgan Keys | Product Designer, AI Builder";
const SITE_DESCRIPTION =
  "Product designer and AI builder who turns messy B2B problems into clear, shipped products.";

export interface Props {
  /** Page name; rendered as "<title> | Morgan Keys". Omit for SITE_TITLE. */
  title?: string;
  description?: string;
  /** Defaults to this page's path on the environment's site URL. */
  canonicalURL?: URL;
  /**
   * Link-preview image for social sites and chat apps. Export at 1200×630.
   * Defaults to src/assets/og/og-image.png.
   */
  shareImage?: ImageMetadata;
  shareImageAlt?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  shareImage = defaultShareImage,
  shareImageAlt = "Morgan Keys, Product Designer and AI Builder",
} = Astro.props;

const siteTitle = title ? `${title} | Morgan Keys` : SITE_TITLE;
// Social sites fetch the preview image from their own servers, so it needs an
// absolute URL on this environment's host.
const shareImageURL = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />

    {/* Link previews on LinkedIn, Slack, iMessage, X, and others. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Morgan Keys" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={shareImageURL.href} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@morgankeys" />

    {/* Belt-and-braces with the generated robots.txt: keeps staging pages out
        of an index even if one is reached directly. */}
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Prevent FOUC by setting data-theme from localStorage before first paint.
         No stored value means "system": follow prefers-color-scheme, live. -->
    <script is:inline>
      (function () {
        const query = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : query.matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        }
        apply();
        query.addEventListener("change", apply);
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
    <StagingBanner />
    <ImageZoomOverlay />
    <script>
      import "../scripts/button-ripple";
      import "../scripts/external-links";
      import "../scripts/figma-capture";
    </script>
  </body>
</html>

<style>
  /* BaseLayout has no scoped styles; theme attributes live on :root via inline script */
</style>
