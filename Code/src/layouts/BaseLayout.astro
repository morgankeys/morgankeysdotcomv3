---
/**
 * BaseLayout.astro
 *
 * Foundation layout providing <head>, global CSS, theme data attributes, and slots.
 * All pages extend this layout for consistent site-wide structure.
 */

import '../styles/global.css';
import '../styles/brand.css';
import StagingBanner from '../components/StagingBanner.astro';
import { isStaging } from '../lib/env';

export interface Props {
  title: string;
  description?: string;
  canonicalURL?: URL;
}

const {
  title,
  description = "Product designer & creative technologist",
  canonicalURL,
} = Astro.props;

const siteTitle = title === "Morgan Keys" ? title : `${title} | Morgan Keys`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

    {/* Belt-and-braces with the generated robots.txt: keeps staging pages out
        of an index even if one is reached directly. */}
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Prevent FOUC by setting data-theme from localStorage before first paint.
         No stored value means "system": follow prefers-color-scheme, live. -->
    <script is:inline>
      (function () {
        const query = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : query.matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        }
        apply();
        query.addEventListener("change", apply);
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
    <StagingBanner />
  </body>
</html>

<style>
  /* BaseLayout has no scoped styles; theme attributes live on :root via inline script */
</style>
