{
  "name": "morgankeysdotcom",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run tokens && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens:unpack": "node tokens/unpack.mjs",
    "tokens:build": "node tokens/build.mjs",
